# name: test/sql/db2/07_decimal.test
# description: test for DECIMAL type with DB2
# group: [db2_07_decimal]

require odbc_scanner

require-env ODBC_CONN_STRING

statement ok
SET VARIABLE conn = odbc_connect('${ODBC_CONN_STRING}')

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(''1.234'' AS DECIMAL(4,3)) FROM sysibm.sysdummy1')
----
1.234

query I
SELECT column_type from (
  DESCRIBE FROM odbc_query(getvariable('conn'), 'SELECT CAST(''1.234'' AS DECIMAL(4,3)) FROM sysibm.sysdummy1')
)
----
DECIMAL(4,3)

query I
SELECT column_type from (
  DESCRIBE FROM odbc_query(getvariable('conn'), 'SELECT CAST(''1.234'' AS NUMERIC(4,3)) FROM sysibm.sysdummy1')
)
----
DECIMAL(4,3)

statement error
FROM odbc_query(getvariable('conn'), 'SELECT CAST(''1.234'' AS DECIMAL(4,3)) FROM sysibm.sysdummy1',
  decimal_columns_as_chars=FALSE)
----
CLI0122E  Program type out of range. SQLSTATE=HY003

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(''123456.789'' AS DECIMAL(9,3)) FROM sysibm.sysdummy1')
----
123456.789

query I
SELECT column_type from (
  DESCRIBE FROM odbc_query(getvariable('conn'), 'SELECT CAST(''123456.789'' AS DECIMAL(9,3)) FROM sysibm.sysdummy1')
)
----
DECIMAL(9,3)

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(''123456789012345.123'' AS DECIMAL(18,3)) FROM sysibm.sysdummy1')
----
123456789012345.123

query I
SELECT column_type from (
  DESCRIBE FROM odbc_query(getvariable('conn'), 'SELECT CAST(''123456789012345.123'' AS DECIMAL(18,3)) FROM sysibm.sysdummy1')
)
----
DECIMAL(18,3)

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(''1234567890123456789012345678.123'' AS DECIMAL(31,3)) FROM sysibm.sysdummy1')
----
1234567890123456789012345678.123

query I
SELECT column_type from (
  DESCRIBE FROM odbc_query(getvariable('conn'), 'SELECT CAST(''1234567890123456789012345678.123'' AS DECIMAL(31,3)) FROM sysibm.sysdummy1')
)
----
DECIMAL(31,3)

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS DECIMAL(31,3)) FROM sysibm.sysdummy1',
  params=row('1234567890123456789012345678.123'::DECIMAL(31,3)))
----
1234567890123456789012345678.123

statement ok
PREPARE p16 AS FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS DECIMAL(4,3)) FROM sysibm.sysdummy1',
  params=row(?))

query I
EXECUTE p16('1.234'::DECIMAL(4,3))
----
1.234

query I
EXECUTE p16('9.999'::DECIMAL(4,3))
----
9.999

query I
EXECUTE p16('-1.234'::DECIMAL(4,3))
----
-1.234

query I
EXECUTE p16('-9.999'::DECIMAL(4,3))
----
-9.999

query I
EXECUTE p16('0.000'::DECIMAL(4,3))
----
0.000

query I
EXECUTE p16('-0.000'::DECIMAL(4,3))
----
-0.000

statement ok
DEALLOCATE p16

statement ok
PREPARE p32 AS FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS DECIMAL(9,3)) FROM sysibm.sysdummy1',
  params=row(?))

query I
EXECUTE p32('123456.789'::DECIMAL(9,3))
----
123456.789

query I
EXECUTE p32('999999.999'::DECIMAL(9,3))
----
999999.999

query I
EXECUTE p32('-123456.789'::DECIMAL(9,3))
----
-123456.789

query I
EXECUTE p32('-999999.999'::DECIMAL(9,3))
----
-999999.999

query I
EXECUTE p32('000000.000'::DECIMAL(9,3))
----
000000.000

query I
EXECUTE p32('-000000.000'::DECIMAL(9,3))
----
-000000.000

statement ok
DEALLOCATE p32

statement ok
PREPARE p64 AS FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS DECIMAL(18,3)) FROM sysibm.sysdummy1',
  params=row(?))

query I
EXECUTE p64('123456789012345.123'::DECIMAL(18,3))
----
123456789012345.123

query I
EXECUTE p64('999999999999999.999'::DECIMAL(18,3))
----
999999999999999.999

query I
EXECUTE p64('-123456789012345.123'::DECIMAL(18,3))
----
-123456789012345.123

query I
EXECUTE p64('-999999999999999.999'::DECIMAL(18,3))
----
-999999999999999.999

query I
EXECUTE p64('000000000000000.000'::DECIMAL(18,3))
----
000000000000000.000

query I
EXECUTE p64('-000000000000000.000'::DECIMAL(18,3))
----
-000000000000000.000

statement ok
DEALLOCATE p64

statement ok
PREPARE p128 AS FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS DECIMAL(31,3)) FROM sysibm.sysdummy1',
  params=row(?))

query I
EXECUTE p128('1234567890123456789012345678.123'::DECIMAL(31,3))
----
1234567890123456789012345678.123

query I
EXECUTE p128('9999999999999999999999999999.999'::DECIMAL(31,3))
----
9999999999999999999999999999.999

query I
EXECUTE p128('-1234567890123456789012345678.123'::DECIMAL(31,3))
----
-1234567890123456789012345678.123

query I
EXECUTE p128('-9999999999999999999999999999.999'::DECIMAL(31,3))
----
-9999999999999999999999999999.999

query I
EXECUTE p128('0000000000000000000000000000.000'::DECIMAL(31,3))
----
0000000000000000000000000000.000

query I
EXECUTE p128('-0000000000000000000000000000.000'::DECIMAL(31,3))
----
-0000000000000000000000000000.000

statement ok
DEALLOCATE p128

statement ok
SELECT odbc_close(getvariable('conn'))
