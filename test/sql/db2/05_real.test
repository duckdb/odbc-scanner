# name: test/sql/db2/05_real.test
# description: test for DB2 REAL type
# group: [db2_05_real]

require odbc_scanner

require-env ODBC_CONN_STRING

statement ok
SET VARIABLE conn = odbc_connect('${ODBC_CONN_STRING}')

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(42.123 AS REAL) FROM sysibm.sysdummy1')
----
42.123

query I
SELECT column_type from (
  DESCRIBE FROM odbc_query(getvariable('conn'), 'SELECT CAST(42.123 AS REAL) FROM sysibm.sysdummy1')
)
----
FLOAT

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(42.123 AS REAL) FROM sysibm.sysdummy1')
----
42.123

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS REAL) FROM sysibm.sysdummy1', params=row(42.123::FLOAT))
----
42.123

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS REAL) FROM sysibm.sysdummy1', params=row(0::FLOAT))
----
0

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS REAL) FROM sysibm.sysdummy1', params=row(-42.123::FLOAT))
----
-42.123

statement ok
PREPARE p1 AS FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS REAL) FROM sysibm.sysdummy1', params=row(?))

query I
EXECUTE p1(42.123::FLOAT)
----
42.123

statement ok
DEALLOCATE p1

statement ok
SELECT odbc_close(getvariable('conn'))
