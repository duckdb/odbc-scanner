# name: test/sql/db2/15_binary.test
# description: test for DB2 BINARY type
# group: [db2_15_binary]

require odbc_scanner

require-env ODBC_CONN_STRING

statement ok
SET VARIABLE conn = odbc_connect('${ODBC_CONN_STRING}')

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(''foo'' AS BINARY(3)) FROM sysibm.sysdummy1')
----
foo

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(''foo'' AS BINARY(6)) FROM sysibm.sysdummy1')
----
foo\x00\x00\x00

query I
SELECT column_type from (
  DESCRIBE FROM odbc_query(getvariable('conn'), 'SELECT CAST(''foo'' AS BINARY(3)) FROM sysibm.sysdummy1')
)
----
BLOB

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS BINARY(3)) FROM sysibm.sysdummy1',
  params=row('foo'::BLOB))
----
foo

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS BINARY(6)) FROM sysibm.sysdummy1',
  params=row('foo'::BLOB))
----
foo\x00\x00\x00

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS BINARY(7)) FROM sysibm.sysdummy1',
  params=row('foo\x00bar'::BLOB))
----
foo\x00bar

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS BINARY(2)) FROM sysibm.sysdummy1',
  params=row(NULL::BLOB))
----
NULL

statement ok
PREPARE p1 AS FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS BINARY(7)) FROM sysibm.sysdummy1',
  params=row(?))

query I
EXECUTE p1('foo\x00bar'::BLOB)
----
foo\x00bar

statement ok
DEALLOCATE p1

statement ok
SELECT odbc_close(getvariable('conn'))
