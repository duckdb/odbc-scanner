# name: test/sql/db2/12_char.test
# description: test for DB2 CHAR type
# group: [db2_12_char]

require odbc_scanner

require-env ODBC_CONN_STRING

statement ok
SET VARIABLE conn = odbc_connect('${ODBC_CONN_STRING}')

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(''foo'' AS CHAR(3)) FROM sysibm.sysdummy1')
----
foo

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(''foo'' AS CHAR(6)) FROM sysibm.sysdummy1')
----
foo   

query I
SELECT column_type from (
  DESCRIBE FROM odbc_query(getvariable('conn'), 'SELECT CAST(''foo'' AS CHAR(3)) FROM sysibm.sysdummy1')
)
----
VARCHAR

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS CHAR(3)) FROM sysibm.sysdummy1',
  params=row('foo'::VARCHAR))
----
foo

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS CHAR(4)) FROM sysibm.sysdummy1',
  params=row('🌌'::VARCHAR))
----
🌌

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS CHAR(2)) FROM sysibm.sysdummy1',
  params=row(NULL::VARCHAR))
----
NULL

statement ok
PREPARE p1 AS FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS CHAR(4)) FROM sysibm.sysdummy1',
  params=row(?))

query I
EXECUTE p1('foo1'::VARCHAR)
----
foo1

query I
EXECUTE p1('bar1'::VARCHAR)
----
bar1

query I
EXECUTE p1('🌌'::VARCHAR)
----
🌌

statement ok
DEALLOCATE p1

statement ok
SELECT odbc_close(getvariable('conn'))
