# name: test/sql/db2/02_smallint.test
# description: test for SMALLINT type with DB2
# group: [db2_02_smallint]

require odbc_scanner

require-env ODBC_CONN_STRING

statement ok
SET VARIABLE conn = odbc_connect('${ODBC_CONN_STRING}')

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(42 AS SMALLINT) FROM sysibm.sysdummy1')
----
42

query I
SELECT column_type from (
  DESCRIBE FROM odbc_query(getvariable('conn'), 'SELECT CAST(42 AS SMALLINT) FROM sysibm.sysdummy1')
)
----
SMALLINT

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS SMALLINT) FROM sysibm.sysdummy1', params=row(42::SMALLINT))
----
42

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS SMALLINT) FROM sysibm.sysdummy1', params=row(0::SMALLINT))
----
0

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS SMALLINT) FROM sysibm.sysdummy1', params=row(32767::SMALLINT))
----
32767

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS SMALLINT) FROM sysibm.sysdummy1', params=row(-32767::SMALLINT))
----
-32767

statement ok
PREPARE p1 AS FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS SMALLINT) FROM sysibm.sysdummy1', params=row(?))

query I
EXECUTE p1(32767::SMALLINT)
----
32767

statement ok
DEALLOCATE p1

statement ok
SELECT odbc_close(getvariable('conn'))
