# name: test/sql/db2/04_bigint.test
# description: test for BIGINT type with DB2
# group: [db2_04_bigint]

require odbc_scanner

require-env ODBC_CONN_STRING

statement ok
SET VARIABLE conn = odbc_connect('${ODBC_CONN_STRING}')

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(42 AS BIGINT) FROM sysibm.sysdummy1')
----
42

query I
SELECT column_type from (
  DESCRIBE FROM odbc_query(getvariable('conn'), 'SELECT CAST(42 AS BIGINT) FROM sysibm.sysdummy1')
)
----
BIGINT

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS BIGINT) FROM sysibm.sysdummy1', params=row(42::BIGINT))
----
42

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS BIGINT) FROM sysibm.sysdummy1', params=row(0::BIGINT))
----
0

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS BIGINT) FROM sysibm.sysdummy1', params=row(9223372036854775807::BIGINT))
----
9223372036854775807

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS BIGINT) FROM sysibm.sysdummy1', params=row(-9223372036854775807::BIGINT))
----
-9223372036854775807

statement ok
PREPARE p1 AS FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS BIGINT) FROM sysibm.sysdummy1', params=row(?))

query I
EXECUTE p1(9223372036854775807::BIGINT)
----
9223372036854775807

statement ok
DEALLOCATE p1

statement ok
SELECT odbc_close(getvariable('conn'))
