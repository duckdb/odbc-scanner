# name: test/sql/db2/09_time.test
# description: test for DB2 TIME type
# group: [db2_09_time]

require odbc_scanner

require-env ODBC_CONN_STRING

statement ok
SET VARIABLE conn = odbc_connect('${ODBC_CONN_STRING}')

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(''23:58:59'' AS TIME) FROM sysibm.sysdummy1')
----
23:58:59

query I
SELECT column_type from (
  DESCRIBE FROM odbc_query(getvariable('conn'), 'SELECT CAST(''23:58:59'' AS TIME) FROM sysibm.sysdummy1')
)
----
TIME

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS TIME) FROM sysibm.sysdummy1', params=row('23:58:59'::TIME))
----
23:58:59

statement ok
PREPARE p1 AS FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS TIME) FROM sysibm.sysdummy1',
  params=row(?))

query I
EXECUTE p1('23:58:59'::TIME)
----
23:58:59

query I
EXECUTE p1('00:00:00'::TIME)
----
00:00:00

statement ok
DEALLOCATE p1

statement ok
SELECT odbc_close(getvariable('conn'))
