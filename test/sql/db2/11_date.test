# name: test/sql/db2/11_date.test
# description: test for DATE type with DB2
# group: [db2_11_date]

require odbc_scanner

require-env ODBC_CONN_STRING

statement ok
SET VARIABLE conn = odbc_connect('${ODBC_CONN_STRING}')

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(''2020-12-31'' AS DATE) FROM sysibm.sysdummy1')
----
2020-12-31

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(''0001-01-01'' AS DATE) FROM sysibm.sysdummy1')
----
0001-01-01

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(''9999-12-31'' AS DATE) FROM sysibm.sysdummy1')
----
9999-12-31

query I
SELECT column_type from (
  DESCRIBE FROM odbc_query(getvariable('conn'), 'SELECT CAST(''2020-12-31'' AS DATE) FROM sysibm.sysdummy1')
)
----
DATE

query II
FROM odbc_query(getvariable('conn'), 'SELECT CAST(42 AS INT), CAST(''2020-12-31'' AS DATE) FROM sysibm.sysdummy1')
----
42	2020-12-31

query II
FROM odbc_query(getvariable('conn'), 'SELECT CAST(''2020-12-31'' AS DATE), CAST(42 AS INT) FROM sysibm.sysdummy1')
----
2020-12-31	42

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS DATE) FROM sysibm.sysdummy1', params=row('2020-12-31'::DATE))
----
2020-12-31

statement ok
PREPARE p1 AS FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS DATE) FROM sysibm.sysdummy1', params=row(?))

query I
EXECUTE p1('2020-12-31'::DATE)
----
2020-12-31

query I
EXECUTE p1('1970-01-01'::DATE)
----
1970-01-01

query I
EXECUTE p1('1969-12-31'::DATE)
----
1969-12-31

query I
EXECUTE p1('0001-01-01'::DATE)
----
0001-01-01

query I
EXECUTE p1('9999-12-31'::DATE)
----
9999-12-31

statement ok
DEALLOCATE p1

statement ok
SELECT odbc_close(getvariable('conn'))
