# name: test/sql/db2/17_blob.test
# description: test for DB2 BLOB type
# group: [db2_17_blob]

require odbc_scanner

require-env ODBC_CONN_STRING

statement ok
SET VARIABLE conn = odbc_connect('${ODBC_CONN_STRING}')

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(hextoraw(''666f6f00626172'') AS BLOB) FROM sysibm.sysdummy1')
----
foo\x00bar

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS BLOB) FROM sysibm.sysdummy1',
  params=row('foo'::BLOB))
----
foo

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS BLOB) FROM sysibm.sysdummy1',
  params=row('foo'::BLOB))
----
foo

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS BLOB) FROM sysibm.sysdummy1',
  params=row('foo\x00bar'::BLOB))
----
foo\x00bar

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS BLOB) FROM sysibm.sysdummy1',
  params=row(NULL::BLOB))
----
NULL

statement ok
PREPARE p1 AS FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS BLOB) FROM sysibm.sysdummy1',
  params=row(?))

query I
EXECUTE p1('foo\x00bar'::BLOB)
----
foo\x00bar

statement ok
DEALLOCATE p1

statement ok
SELECT odbc_close(getvariable('conn'))
