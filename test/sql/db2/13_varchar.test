# name: test/sql/db2/13_varchar.test
# description: test for DB2 VARCHAR type
# group: [db2_13_varchar]

require odbc_scanner

require-env ODBC_CONN_STRING

statement ok
SET VARIABLE conn = odbc_connect('${ODBC_CONN_STRING}')

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(''foo'' AS VARCHAR(3)) FROM sysibm.sysdummy1')
----
foo

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(''foo'' AS VARCHAR(6)) FROM sysibm.sysdummy1')
----
foo

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(''foo'' AS VARCHAR(32672)) FROM sysibm.sysdummy1')
----
foo

query I
SELECT column_type from (
  DESCRIBE FROM odbc_query(getvariable('conn'), 'SELECT CAST(''foo'' AS VARCHAR(32672)) FROM sysibm.sysdummy1')
)
----
VARCHAR

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS VARCHAR(32672)) FROM sysibm.sysdummy1',
  params=row('foo'::VARCHAR))
----
foo

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS VARCHAR(32672)) FROM sysibm.sysdummy1',
  params=row('🌌'::VARCHAR))
----
🌌

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS VARCHAR(32672)) FROM sysibm.sysdummy1',
  params=row(NULL::VARCHAR))
----
NULL

statement ok
PREPARE p1 AS FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS VARCHAR(32672)) FROM sysibm.sysdummy1',
  params=row(?))

query I
EXECUTE p1('foo'::VARCHAR)
----
foo

query I
EXECUTE p1('🌌'::VARCHAR)
----
🌌

statement ok
DEALLOCATE p1

statement ok
SELECT odbc_close(getvariable('conn'))
