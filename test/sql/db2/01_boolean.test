# name: test/sql/db2/01_boolean.test
# description: test for DB2 BOOLEAN type
# group: [db2_01_boolean]

require odbc_scanner

require-env ODBC_CONN_STRING

statement ok
SET VARIABLE conn = odbc_connect('${ODBC_CONN_STRING}')

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(TRUE AS BOOLEAN) FROM sysibm.sysdummy1')
----
TRUE

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(FALSE AS BOOLEAN) FROM sysibm.sysdummy1')
----
FALSE

query I
SELECT column_type from (
  DESCRIBE FROM odbc_query(getvariable('conn'), 'SELECT CAST(TRUE AS BOOLEAN) FROM sysibm.sysdummy1')
)
----
BOOLEAN

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS BOOLEAN) FROM sysibm.sysdummy1', params=row(TRUE))
----
TRUE

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS BOOLEAN) FROM sysibm.sysdummy1', params=row(FALSE))
----
FALSE

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS BOOLEAN) FROM sysibm.sysdummy1', params=row(NULL))
----
NULL

statement ok
PREPARE p1 AS FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS BOOLEAN) FROM sysibm.sysdummy1', params=row(?))

query I
EXECUTE p1(TRUE)
----
TRUE

query I
EXECUTE p1(FALSE)
----
FALSE

query I
EXECUTE p1(NULL)
----
NULL

statement ok
DEALLOCATE p1

statement ok
SELECT odbc_close(getvariable('conn'))
