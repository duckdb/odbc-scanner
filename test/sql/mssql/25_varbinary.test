# name: test/sql/mssql/25_varbinary.test
# description: test for MSSQL VARBINARY type
# group: [mssql_25_varbinary]

require odbc_scanner

require-env ODBC_CONN_STRING

statement ok
SET VARIABLE conn = odbc_connect('${ODBC_CONN_STRING}')

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(''foo'' AS VARBINARY(3))')
----
foo

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(''foo'' AS VARBINARY(7))')
----
foo

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(''foo'' AS VARBINARY(max))')
----
foo

query I
SELECT column_type from (
  DESCRIBE FROM odbc_query(getvariable('conn'), 'SELECT CAST(''foo'' AS VARBINARY(max))')
)
----
BLOB

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS VARBINARY(3))', params=row('foo'::BLOB))
----
foo

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS VARBINARY(6))', params=row('foo'::BLOB))
----
foo

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS VARBINARY(7))', params=row('foo\x00bar'::BLOB))
----
foo\x00bar

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS VARBINARY(max))', params=row('foo\x00bar'::BLOB))
----
foo\x00bar

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS VARBINARY(max))', params=row(NULL::BLOB))
----
NULL

statement ok
PREPARE p1 AS FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS VARBINARY(max))', params=row(?))

query I
EXECUTE p1('foo\x00bar'::BLOB)
----
foo\x00bar

statement ok
DEALLOCATE p1

statement ok
SELECT odbc_close(getvariable('conn'))
