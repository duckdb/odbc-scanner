# name: test/sql/mssql/02_smallint.test
# description: test for SMALLINT type with MSSQL
# group: [mssql_02_smallint]

require odbc_scanner

require-env ODBC_CONN_STRING

statement ok
SET VARIABLE conn = odbc_connect('${ODBC_CONN_STRING}')

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(42 AS SMALLINT)')
----
42

query I
SELECT column_type from (
  DESCRIBE FROM odbc_query(getvariable('conn'), 'SELECT CAST(42 AS SMALLINT)')
)
----
SMALLINT

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(42 AS SMALLINT)',
  enable_columns_binding=TRUE)
----
42

statement error
FROM odbc_query(getvariable('conn'), 'SELECT CAST(''foo'' AS NVARCHAR(max)), CAST(42 AS SMALLINT)',
  enable_columns_binding=TRUE)
----
Invalid Descriptor Index

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS SMALLINT)', params=row(42::SMALLINT))
----
42

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS SMALLINT)', params=row(0::SMALLINT))
----
0

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS SMALLINT)', params=row(32767::SMALLINT))
----
32767

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS SMALLINT)', params=row(-32767::SMALLINT))
----
-32767

statement ok
PREPARE p1 AS FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS SMALLINT)', params=row(?))

query I
EXECUTE p1(32767::SMALLINT)
----
32767

statement ok
DEALLOCATE p1

statement ok
SELECT odbc_close(getvariable('conn'))
