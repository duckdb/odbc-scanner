# name: test/sql/mssql/22_nvarchar.test
# description: test for MSSQL NVARCHAR type
# group: [mssql_22_nvarchar]

require odbc_scanner

require-env ODBC_CONN_STRING

statement ok
SET VARIABLE conn = odbc_connect('${ODBC_CONN_STRING}')

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(''foo'' AS NVARCHAR(3))')
----
foo

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(''foo'' AS NVARCHAR(6))')
----
foo

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(''foo'' AS NVARCHAR(MAX))')
----
foo

query I
SELECT column_type from (
  DESCRIBE FROM odbc_query(getvariable('conn'), 'SELECT CAST(''foo'' AS NVARCHAR(MAX))')
)
----
VARCHAR

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS NVARCHAR(MAX))', params=row('foo'::VARCHAR))
----
foo

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS NVARCHAR(MAX))', params=row('🌌'::VARCHAR))
----
🌌

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS NVARCHAR(MAX))', params=row(NULL::VARCHAR))
----
NULL

statement ok
PREPARE p1 AS FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS NVARCHAR(MAX))', params=row(?))

query I
EXECUTE p1('foo'::VARCHAR)
----
foo

query I
EXECUTE p1('🌌'::VARCHAR)
----
🌌

statement ok
DEALLOCATE p1

statement ok
SELECT odbc_close(getvariable('conn'))
