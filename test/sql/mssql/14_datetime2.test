# name: test/sql/mssql/14_datetime2.test
# description: test for DATETIME2 type with MSSQL
# group: [mssql_14_datetime2]

require odbc_scanner

require-env ODBC_CONN_STRING

require icu

statement ok
SET VARIABLE conn = odbc_connect('${ODBC_CONN_STRING}')

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(''2020-12-31 23:58:59.1234567'' AS DATETIME2)')
----
2020-12-31 23:58:59.123456

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(''2020-12-31 23:58:59.1234567'' AS DATETIME2)',
  timestamp_columns_as_timestamp_ns=TRUE)
----
2020-12-31 23:58:59.1234567

query I
SELECT column_type from (
  DESCRIBE FROM odbc_query(getvariable('conn'), 'SELECT CAST(''2020-12-31 23:58:59.1234567'' AS DATETIME2)')
)
----
TIMESTAMP

query I
SELECT column_type from (
  DESCRIBE FROM odbc_query(getvariable('conn'), 'SELECT CAST(''2020-12-31 23:58:59.1234567'' AS DATETIME2)',
    timestamp_columns_as_timestamp_ns=TRUE)
)
----
TIMESTAMP_NS

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(''2020-12-31 23:58:59.123456'' AS DATETIME2)',
  enable_columns_binding=TRUE)
----
2020-12-31 23:58:59.123456

statement error
FROM odbc_query(getvariable('conn'), 'SELECT CAST(''foo'' AS NVARCHAR(max)), CAST(''2020-12-31 23:58:59.123456'' AS DATETIME2)',
  enable_columns_binding=TRUE)
----
Invalid Descriptor Index

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS DATETIME2)', params=row('2020-12-31 23:58:59.123456'::TIMESTAMP))
----
2020-12-31 23:58:59.123456

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS DATETIME2)', params=row('2020-12-31 23:58:59.1234567'::TIMESTAMP_NS))
----
2020-12-31 23:58:59.123456

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS DATETIME2)', params=row('2020-12-31 23:58:59.1234567'::TIMESTAMP_NS),
  timestamp_columns_as_timestamp_ns=TRUE)
----
2020-12-31 23:58:59.1234567

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS DATETIME2)', params=row('2020-12-31 23:58:59.123456789'::TIMESTAMP_NS))
----
2020-12-31 23:58:59.123456

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS DATETIME2)', params=row('2020-12-31 23:58:59.123456789'::TIMESTAMP_NS),
  timestamp_columns_as_timestamp_ns=TRUE)
----
2020-12-31 23:58:59.1234567

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS DATETIME2(3))', params=row('2020-12-31 23:58:59.123456'::TIMESTAMP))
----
2020-12-31 23:58:59.123

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS DATETIME2)', params=row('0001-01-01 00:00:00.000000'::TIMESTAMP))
----
0001-01-01 00:00:00

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS DATETIME2)', params=row('0001-01-01 00:00:00.000000'::TIMESTAMP),
  timestamp_columns_as_timestamp_ns=TRUE)
----
-infinity

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS DATETIME2)', params=row('9999-12-31 23:59:59.999999'::TIMESTAMP))
----
9999-12-31 23:59:59.999999

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS DATETIME2)', params=row('9999-12-31 23:59:59.999999'::TIMESTAMP),
  timestamp_columns_as_timestamp_ns=TRUE)
----
infinity

statement ok
PREPARE p1 AS FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS DATETIME2)', params=row(?))

query I
EXECUTE p1('2020-12-31 23:58:59.123456'::TIMESTAMP)
----
2020-12-31 23:58:59.123456

query I
EXECUTE p1('2020-12-31 23:58:59.1234567'::TIMESTAMP_NS)
----
2020-12-31 23:58:59.123456

query I
EXECUTE p1('1970-01-01 00:00:00'::TIMESTAMP)
----
1970-01-01 00:00:00

query I
EXECUTE p1('1969-12-31 00:00:00'::TIMESTAMP)
----
1969-12-31 00:00:00

statement ok
DEALLOCATE p1

statement ok
PREPARE p2 AS FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS DATETIME2)',
  params=row(?),
  timestamp_columns_as_timestamp_ns=TRUE)

query I
EXECUTE p2('2020-12-31 23:58:59.123456'::TIMESTAMP)
----
2020-12-31 23:58:59.123456

query I
EXECUTE p2('2020-12-31 23:58:59.1234567'::TIMESTAMP_NS)
----
2020-12-31 23:58:59.1234567

query I
EXECUTE p2('2020-12-31 23:58:59.123456789'::TIMESTAMP_NS)
----
2020-12-31 23:58:59.1234567

query I
EXECUTE p2('0001-01-01 00:00:00.000000'::TIMESTAMP)
----
-infinity

query I
EXECUTE p2('9999-12-31 23:59:59.999999'::TIMESTAMP)
----
infinity

statement ok
DEALLOCATE p2

statement ok
SELECT odbc_close(getvariable('conn'))
