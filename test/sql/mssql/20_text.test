# name: test/sql/mssql/20_text.test
# description: test for MSSQL TEXT type
# group: [mssql_20_text]

require odbc_scanner

require-env ODBC_CONN_STRING

statement ok
SET VARIABLE conn = odbc_connect('${ODBC_CONN_STRING}')

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(''foo'' AS TEXT)')
----
foo

query I
SELECT column_type from (
  DESCRIBE FROM odbc_query(getvariable('conn'), 'SELECT CAST(''foo'' AS TEXT)')
)
----
VARCHAR

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS TEXT)', params=row('foo'::VARCHAR))
----
foo

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS TEXT)', params=row('🌌'::VARCHAR))
----
??

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS TEXT)', params=row(NULL::VARCHAR))
----
NULL

statement ok
PREPARE p1 AS FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS TEXT)', params=row(?))

query I
EXECUTE p1('foo'::VARCHAR)
----
foo

query I
EXECUTE p1('bar'::VARCHAR)
----
bar

statement ok
DEALLOCATE p1

statement ok
SELECT odbc_close(getvariable('conn'))
