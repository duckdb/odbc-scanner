# name: test/sql/mssql/08_money.test
# description: test for MONEY type with MSSQL
# group: [mssql_08_money]

require odbc_scanner

require-env ODBC_CONN_STRING

statement ok
SET VARIABLE conn = odbc_connect('${ODBC_CONN_STRING}')

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(42.1234 AS MONEY)')
----
42.1234

query I
SELECT column_type from (
  DESCRIBE FROM odbc_query(getvariable('conn'), 'SELECT CAST(41.1234 AS MONEY)')
)
----
DECIMAL(19,4)

statement error
FROM odbc_query(getvariable('conn'), 'SELECT CAST(42.1234 AS MONEY)',
  enable_columns_binding=TRUE)
----
Inconsistent descriptor information

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS MONEY)', params=row(42.1234::DECIMAL(19,4)))
----
42.1234

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS MONEY)', params=row(0::DECIMAL(19,4)))
----
0

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS MONEY)', params=row(922337203685477.5807::DECIMAL(19,4)))
----
922337203685477.5807

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS MONEY)', params=row(-922337203685477.5808::DECIMAL(19,4)))
----
-922337203685477.5808

statement ok
PREPARE p1 AS FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS MONEY)', params=row(?))

query I
EXECUTE p1(922337203685477.5807::DECIMAL(19,4))
----
922337203685477.5807

query I
EXECUTE p1(-922337203685477.5808::DECIMAL(19,4))
----
-922337203685477.5808

statement ok
DEALLOCATE p1

statement ok
SELECT odbc_close(getvariable('conn'))
