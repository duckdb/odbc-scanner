# name: test/sql/mssql/13_time.test
# description: test for MSSQL TIME type
# group: [mssql_13_time]

require odbc_scanner

require-env ODBC_CONN_STRING

statement ok
SET VARIABLE conn = odbc_connect('${ODBC_CONN_STRING}')

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(''23:58:59.123456'' AS TIME)')
----
23:58:59.123456

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(''23:58:59.1234567'' AS TIME)')
----
23:58:59.123456

query I
SELECT column_type from (
  DESCRIBE FROM odbc_query(getvariable('conn'), 'SELECT CAST(''23:58:59.123456'' AS TIME)')
)
----
TIME

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(''23:58:59.123456'' AS TIME)',
  enable_columns_binding=TRUE)
----
23:58:59.123456

statement error
FROM odbc_query(getvariable('conn'), 'SELECT CAST(''foo'' AS NVARCHAR(max)), CAST(''23:58:59.123456'' AS TIME)',
  enable_columns_binding=TRUE)
----
Invalid Descriptor Index

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS TIME)', params=row('23:58:59.123456'::TIME))
----
23:58:59.123456

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS TIME(3))', params=row('23:58:59.123456'::TIME))
----
23:58:59.123

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS TIME)', params=row('23:58:59.023456'::TIME))
----
23:58:59.023456

statement ok
PREPARE p1 AS FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS TIME)', params=row(?))

query I
EXECUTE p1('23:58:59.123456'::TIME)
----
23:58:59.123456

query I
EXECUTE p1('00:00:00'::TIME)
----
00:00:00

query I
EXECUTE p1('23:58:59.123'::TIME)
----
23:58:59.123

statement ok
DEALLOCATE p1

statement ok
SELECT odbc_close(getvariable('conn'))
