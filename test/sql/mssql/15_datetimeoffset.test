
# name: test/sql/mssql/15_datetimeoffset.test
# description: test for DATETIMEOFFSET type with MSSQL
# group: [mssql_15_datetimeoffset]

require odbc_scanner

require-env ODBC_CONN_STRING

require icu

statement ok
set TimeZone = 'Australia/Darwin'

query I
SELECT timezone(current_timestamp)
----
34200

statement ok
SET VARIABLE conn = odbc_connect('${ODBC_CONN_STRING}')

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(''2020-12-31 23:58:59.1234567+00:00'' AS DATETIMEOFFSET)')
----
2021-01-01 09:28:59.123456+09:30

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(''2020-12-31 23:58:59.1234567+00:01'' AS DATETIMEOFFSET)')
----
2021-01-01 09:27:59.123456+09:30

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(''2020-12-31 23:58:59.1234567-05:00'' AS DATETIMEOFFSET)')
----
2021-01-01 14:28:59.123456+09:30

query I
SELECT column_type from (
  DESCRIBE FROM odbc_query(getvariable('conn'), 'SELECT CAST(''2020-12-31 23:58:59.1234567-05:00'' AS DATETIMEOFFSET)')
)
----
TIMESTAMP WITH TIME ZONE

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(''2020-12-31 23:58:59.1234567-05:00'' AS DATETIMEOFFSET)',
  enable_columns_binding=TRUE)
----
2021-01-01 14:28:59.123456+09:30

statement error
FROM odbc_query(getvariable('conn'), 'SELECT CAST(''foo'' AS NVARCHAR(max)), CAST(''2020-12-31 23:58:59.1234567-05:00'' AS DATETIMEOFFSET)',
  enable_columns_binding=TRUE)
----
Invalid Descriptor Index

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS DATETIMEOFFSET)',
  params=row('2020-12-31 23:58:59.123456+00:00'::TIMESTAMP WITH TIME ZONE))
----
2021-01-01 09:28:59.123456+09:30

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS DATETIMEOFFSET)',
  params=row('2020-12-31 23:58:59.123456+00:01'::TIMESTAMP WITH TIME ZONE))
----
2021-01-01 09:27:59.123456+09:30

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS DATETIMEOFFSET)',
  params=row('2020-12-31 23:58:59.123456-05:00'::TIMESTAMP WITH TIME ZONE))
----
2021-01-01 14:28:59.123456+09:30

statement ok
PREPARE p1 AS FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS DATETIMEOFFSET)', params=row(?))

query I
EXECUTE p1('2020-12-31 23:58:59.123456+00:00'::TIMESTAMP WITH TIME ZONE)
----
2021-01-01 09:28:59.123456+09:30

query I
EXECUTE p1('2020-12-31 23:58:59.123456+00:01'::TIMESTAMP WITH TIME ZONE)
----
2021-01-01 09:27:59.123456+09:30

query I
EXECUTE p1('2020-12-31 23:58:59.123456-05:00'::TIMESTAMP WITH TIME ZONE)
----
2021-01-01 14:28:59.123456+09:30

statement ok
DEALLOCATE p1

statement ok
SELECT odbc_close(getvariable('conn'))

statement ok
set TimeZone = 'UTC'
