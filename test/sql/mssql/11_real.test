# name: test/sql/mssql/11_real.test
# description: test for MSSQL REAL type
# group: [mssql_11_real]

require odbc_scanner

require-env ODBC_CONN_STRING

statement ok
SET VARIABLE conn = odbc_connect('${ODBC_CONN_STRING}')

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(42.123 AS REAL)')
----
42.123

query I
SELECT column_type from (
  DESCRIBE FROM odbc_query(getvariable('conn'), 'SELECT CAST(42.123 AS REAL)')
)
----
FLOAT

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(42.123 AS REAL)')
----
42.123

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(42.123 AS REAL)',
  enable_columns_binding=TRUE)
----
42.123

statement error
FROM odbc_query(getvariable('conn'), 'SELECT CAST(''foo'' AS NVARCHAR(max)), CAST(42.123 AS REAL)',
  enable_columns_binding=TRUE)
----
Invalid Descriptor Index

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS REAL)', params=row(42.123::FLOAT))
----
42.123

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS REAL)', params=row(0::FLOAT))
----
0

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS REAL)', params=row(-42.123::FLOAT))
----
-42.123

statement ok
PREPARE p1 AS FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS REAL)', params=row(?))

query I
EXECUTE p1(42.123::FLOAT)
----
42.123

statement ok
DEALLOCATE p1

statement ok
SELECT odbc_close(getvariable('conn'))
