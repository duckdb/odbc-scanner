# name: test/sql/mssql/05_bit.test
# description: test for BIT type with MSSQL
# group: [mssql_05_bit]

require odbc_scanner

require-env ODBC_CONN_STRING

statement ok
SET VARIABLE conn = odbc_connect('${ODBC_CONN_STRING}')

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(1 AS BIT)')
----
TRUE

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(0 AS BIT)')
----
FALSE

query I
SELECT column_type from (
  DESCRIBE FROM odbc_query(getvariable('conn'), 'SELECT CAST(1 AS BIT)')
)
----
BOOLEAN

query II
FROM odbc_query(getvariable('conn'), 'SELECT CAST(42 AS INT), CAST(1 AS BIT)')
----
42	1

statement error
FROM odbc_query(getvariable('conn'), 'SELECT CAST(''foo'' AS NVARCHAR(max)), CAST(1 AS BIT)',
  enable_columns_binding=TRUE)
----
Invalid Descriptor Index

query II
FROM odbc_query(getvariable('conn'), 'SELECT CAST(0 AS BIT), CAST(1 AS BIT)',
  enable_columns_binding=TRUE)
----
0	1

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS BIT)', params=row(TRUE))
----
TRUE

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS BIT)', params=row(FALSE))
----
FALSE

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS BIT)', params=row(NULL))
----
NULL

statement ok
PREPARE p1 AS FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS BIT)', params=row(?))

query I
EXECUTE p1(TRUE)
----
TRUE

query I
EXECUTE p1(FALSE)
----
FALSE

query I
EXECUTE p1(NULL)
----
NULL

statement ok
DEALLOCATE p1

statement ok
SELECT odbc_close(getvariable('conn'))
