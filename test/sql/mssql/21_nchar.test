# name: test/sql/mssql/21_nchar.test
# description: test for MSSQL NCHAR type
# group: [mssql_21_nchar]

require odbc_scanner

require-env ODBC_CONN_STRING

statement ok
SET VARIABLE conn = odbc_connect('${ODBC_CONN_STRING}')

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(''foo'' AS NCHAR(3))')
----
foo

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(''foo'' AS NCHAR(6))')
----
foo   

query I
SELECT column_type from (
  DESCRIBE FROM odbc_query(getvariable('conn'), 'SELECT CAST(''foo'' AS NCHAR(3))')
)
----
VARCHAR

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS NCHAR(3))', params=row('foo'::VARCHAR))
----
foo

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS NCHAR(2))', params=row('🌌'::VARCHAR))
----
🌌

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS NCHAR(2))', params=row(NULL::VARCHAR))
----
NULL

statement ok
PREPARE p1 AS FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS NCHAR(3))', params=row(?))

query I
EXECUTE p1('foo'::VARCHAR)
----
foo

query I
EXECUTE p1('🌌'::VARCHAR)
----
🌌 

statement ok
DEALLOCATE p1

statement ok
SELECT odbc_close(getvariable('conn'))
