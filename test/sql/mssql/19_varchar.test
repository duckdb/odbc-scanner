# name: test/sql/mssql/19_varchar.test
# description: test for MSSQL VARCHAR type
# group: [mssql_19_nvarchar]

require odbc_scanner

require-env ODBC_CONN_STRING

statement ok
SET VARIABLE conn = odbc_connect('${ODBC_CONN_STRING}')

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(''foo'' AS VARCHAR(3))')
----
foo

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(''foo'' AS VARCHAR(6))')
----
foo

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(''foo'' AS VARCHAR(MAX))')
----
foo

query I
SELECT column_type from (
  DESCRIBE FROM odbc_query(getvariable('conn'), 'SELECT CAST(''foo'' AS VARCHAR(MAX))')
)
----
VARCHAR

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS VARCHAR(MAX))', params=row('foo'::VARCHAR))
----
foo

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS VARCHAR(MAX))', params=row('🌌'::VARCHAR))
----
??

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS VARCHAR(MAX))', params=row(NULL::VARCHAR))
----
NULL

statement ok
PREPARE p1 AS FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS VARCHAR(MAX))', params=row(?))

query I
EXECUTE p1('foo'::VARCHAR)
----
foo

query I
EXECUTE p1('bar'::VARCHAR)
----
bar

statement ok
DEALLOCATE p1

statement ok
SELECT odbc_close(getvariable('conn'))
