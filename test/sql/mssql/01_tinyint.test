# name: test/sql/mssql/01_tinyint.test
# description: test for MSSQL TINYINT type
# group: [mssql_01_tinyint]

require odbc_scanner

require-env ODBC_CONN_STRING

statement ok
SET VARIABLE conn = odbc_connect('${ODBC_CONN_STRING}')

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(42 AS TINYINT)')
----
42

query I
SELECT column_type from (
  DESCRIBE FROM odbc_query(getvariable('conn'), 'SELECT CAST(42 AS TINYINT)')
)
----
UTINYINT

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(42 AS TINYINT)',
  enable_columns_binding=TRUE)
----
42

statement error
FROM odbc_query(getvariable('conn'), 'SELECT CAST(''foo'' AS NVARCHAR(max)), CAST(42 AS TINYINT)',
  enable_columns_binding=TRUE)
----
Invalid Descriptor Index

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS TINYINT)', params=row(42::UTINYINT))
----
42

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS TINYINT)', params=row(0::UTINYINT))
----
0

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS TINYINT)', params=row(255::UTINYINT))
----
255

statement ok
PREPARE p1 AS FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS TINYINT)', params=row(?))

query I
EXECUTE p1(255::UTINYINT)
----
255

statement ok
DEALLOCATE p1

statement ok
SELECT odbc_close(getvariable('conn'))
