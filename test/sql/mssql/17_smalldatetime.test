# name: test/sql/mssql/17_smalldatetime.test
# description: test for SMALLDATETIME type with MSSQL
# group: [mssql_17_smalldatetime]

require odbc_scanner

require-env ODBC_CONN_STRING

statement ok
SET VARIABLE conn = odbc_connect('${ODBC_CONN_STRING}')

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(''2020-12-31 23:58:00'' AS SMALLDATETIME)')
----
2020-12-31 23:58:00

query I
SELECT column_type from (
  DESCRIBE FROM odbc_query(getvariable('conn'), 'SELECT CAST(''2020-12-31 23:58:00'' AS SMALLDATETIME)')
)
----
TIMESTAMP

query I
SELECT column_type from (
  DESCRIBE FROM odbc_query(getvariable('conn'), 'SELECT CAST(''2020-12-31 23:58:00'' AS SMALLDATETIME)',
    timestamp_columns_as_timestamp_ns=TRUE)
)
----
TIMESTAMP_NS

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(''2020-12-31 23:58:00'' AS SMALLDATETIME)',
  enable_columns_binding=TRUE)
----
2020-12-31 23:58:00

statement error
FROM odbc_query(getvariable('conn'), 'SELECT CAST(''foo'' AS NVARCHAR(max)), CAST(''2020-12-31 23:58:00'' AS SMALLDATETIME)',
  enable_columns_binding=TRUE)
----
Invalid Descriptor Index

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS SMALLDATETIME)', params=row('2020-12-31 23:58:00'::TIMESTAMP))
----
2020-12-31 23:58:00

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS SMALLDATETIME)', params=row('2020-12-31 23:58:59.123456'::TIMESTAMP))
----
2020-12-31 23:59:00

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS SMALLDATETIME)', params=row('1900-01-01 00:00:00.000000'::TIMESTAMP))
----
1900-01-01 00:00:00

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS SMALLDATETIME)', params=row('2079-06-06 23:59:00'::TIMESTAMP))
----
2079-06-06 23:59:00

statement ok
PREPARE p1 AS FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS SMALLDATETIME)', params=row(?))

query I
EXECUTE p1('2020-12-31 23:58:00'::TIMESTAMP)
----
2020-12-31 23:58:00

query I
EXECUTE p1('2020-12-31 23:58:59.123456'::TIMESTAMP)
----
2020-12-31 23:59:00

statement ok
DEALLOCATE p1

statement ok
PREPARE p2 AS FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS SMALLDATETIME)',
  params=row(?),
  timestamp_columns_as_timestamp_ns=TRUE)

query I
EXECUTE p2('2020-12-31 23:58:59.123456'::TIMESTAMP)
----
2020-12-31 23:59:00

query I
EXECUTE p2('2020-12-31 23:58:59.123456789'::TIMESTAMP_NS)
----
2020-12-31 23:59:00

query I
EXECUTE p2('1900-01-01 00:00:00.000000'::TIMESTAMP)
----
1900-01-01 00:00:00

query I
EXECUTE p2('2079-06-06 23:59:00.000000'::TIMESTAMP)
----
2079-06-06 23:59:00

statement ok
DEALLOCATE p2


statement ok
SELECT odbc_close(getvariable('conn'))
