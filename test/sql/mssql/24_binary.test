# name: test/sql/mssql/24_binary.test
# description: test for MSSQL BINARY type
# group: [mssql_24_binary]

require odbc_scanner

require-env ODBC_CONN_STRING

statement ok
SET VARIABLE conn = odbc_connect('${ODBC_CONN_STRING}')

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(''foo'' AS BINARY(3))')
----
foo

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(''foo'' AS BINARY(6))')
----
foo\x00\x00\x00

query I
SELECT column_type from (
  DESCRIBE FROM odbc_query(getvariable('conn'), 'SELECT CAST(''foo'' AS BINARY(3))')
)
----
BLOB

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS BINARY(3))', params=row('foo'::BLOB))
----
foo

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS BINARY(6))', params=row('foo'::BLOB))
----
foo\x00\x00\x00

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS BINARY(7))', params=row('foo\x00bar'::BLOB))
----
foo\x00bar

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS BINARY(2))', params=row(NULL::BLOB))
----
NULL

statement ok
PREPARE p1 AS FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS BINARY(7))', params=row(?))

query I
EXECUTE p1('foo\x00bar'::BLOB)
----
foo\x00bar

statement ok
DEALLOCATE p1

statement ok
SELECT odbc_close(getvariable('conn'))
