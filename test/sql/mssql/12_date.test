# name: test/sql/mssql/12_date.test
# description: test for DATE type with MSSQL
# group: [mssql_12_date]

require odbc_scanner

require-env ODBC_CONN_STRING

statement ok
SET VARIABLE conn = odbc_connect('${ODBC_CONN_STRING}')

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(''2020-12-31'' AS DATE)')
----
2020-12-31

query I
SELECT column_type from (
  DESCRIBE FROM odbc_query(getvariable('conn'), 'SELECT CAST(''2020-12-31'' AS DATE)')
)
----
DATE

query II
FROM odbc_query(getvariable('conn'), 'SELECT CAST(''foo'' AS NVARCHAR(max)), CAST(''2020-12-31'' AS DATE)')
----
foo	2020-12-31

query II
FROM odbc_query(getvariable('conn'), 'SELECT CAST(''2020-12-31'' AS DATE), CAST(''foo'' AS NVARCHAR(max))')
----
2020-12-31	foo

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(''2020-12-31'' AS DATE)',
  enable_columns_binding=TRUE)
----
2020-12-31

statement error
FROM odbc_query(getvariable('conn'), 'SELECT CAST(''foo'' AS NVARCHAR(max)), CAST(''2020-12-31'' AS DATE)',
  enable_columns_binding=TRUE)
----
Invalid Descriptor Index

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS DATE)', params=row('2020-12-31'::DATE))
----
2020-12-31

statement ok
PREPARE p1 AS FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS DATE)', params=row(?))

query I
EXECUTE p1('2020-12-31'::DATE)
----
2020-12-31

query I
EXECUTE p1('1970-01-01'::DATE)
----
1970-01-01

query I
EXECUTE p1('1969-12-31'::DATE)
----
1969-12-31

query I
EXECUTE p1('0001-01-01'::DATE)
----
0001-01-01

query I
EXECUTE p1('9999-12-31'::DATE)
----
9999-12-31

statement ok
DEALLOCATE p1

statement ok
SELECT odbc_close(getvariable('conn'))
