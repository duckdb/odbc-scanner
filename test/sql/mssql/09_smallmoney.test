# name: test/sql/mssql/09_smallmoney.test
# description: test for SMALLMONEY type with MSSQL
# group: [mssql_09_smallmoney]

require odbc_scanner

require-env ODBC_CONN_STRING

statement ok
SET VARIABLE conn = odbc_connect('${ODBC_CONN_STRING}')

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(42.1234 AS SMALLMONEY)')
----
42.1234

query I
SELECT column_type from (
  DESCRIBE FROM odbc_query(getvariable('conn'), 'SELECT CAST(41.1234 AS SMALLMONEY)')
)
----
DECIMAL(10,4)

statement error
FROM odbc_query(getvariable('conn'), 'SELECT CAST(42.1234 AS SMALLMONEY)',
  enable_columns_binding=TRUE)
----
Inconsistent descriptor information

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS SMALLMONEY)', params=row(42.1234::DECIMAL(10,4)))
----
42.1234

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS SMALLMONEY)', params=row(0::DECIMAL(10,4)))
----
0

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS SMALLMONEY)', params=row(214748.3647::DECIMAL(10,4)))
----
214748.3647

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS SMALLMONEY)', params=row(-214748.3648::DECIMAL(10,4)))
----
-214748.3648

statement ok
PREPARE p1 AS FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS SMALLMONEY)', params=row(?))

query I
EXECUTE p1(214748.3647::DECIMAL(10,4))
----
214748.3647

query I
EXECUTE p1(-214748.3648::DECIMAL(10,4))
----
-214748.3648

statement ok
DEALLOCATE p1

statement ok
SELECT odbc_close(getvariable('conn'))
