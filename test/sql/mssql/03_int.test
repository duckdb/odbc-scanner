# name: test/sql/mssql/03_int.test
# description: test for INT type with MSSQL
# group: [mssql_03_int]

require odbc_scanner

require-env ODBC_CONN_STRING

statement ok
SET VARIABLE conn = odbc_connect('${ODBC_CONN_STRING}')

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(42 AS INT)')
----
42

query I
SELECT column_type from (
  DESCRIBE FROM odbc_query(getvariable('conn'), 'SELECT CAST(42 AS INT)')
)
----
INTEGER

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(42 AS INT)',
  enable_columns_binding=TRUE)
----
42

statement error
FROM odbc_query(getvariable('conn'), 'SELECT CAST(''foo'' AS NVARCHAR(max)), CAST(42 AS INT)',
  enable_columns_binding=TRUE)
----
Invalid Descriptor Index

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS INT)', params=row(42::INTEGER))
----
42

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS INT)', params=row(0::INTEGER))
----
0

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS INT)', params=row(2147483647::INTEGER))
----
2147483647

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS INT)', params=row(-2147483647::INTEGER))
----
-2147483647

statement ok
PREPARE p1 AS FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS INT)', params=row(?))

query I
EXECUTE p1(2147483647::INTEGER)
----
2147483647

statement ok
DEALLOCATE p1

statement ok
SELECT odbc_close(getvariable('conn'))
