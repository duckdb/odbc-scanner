# name: test/sql/mssql/10_float.test
# description: test for MSSQL FLOAT type
# group: [mssql_10_float]

require odbc_scanner

require-env ODBC_CONN_STRING

statement ok
SET VARIABLE conn = odbc_connect('${ODBC_CONN_STRING}')

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(42.123 AS FLOAT(53))')
----
42.123

query I
SELECT column_type from (
  DESCRIBE FROM odbc_query(getvariable('conn'), 'SELECT CAST(42.123 AS FLOAT)')
)
----
DOUBLE

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(42.123 AS FLOAT(24))')
----
42.123

query I
SELECT column_type from (
  DESCRIBE FROM odbc_query(getvariable('conn'), 'SELECT CAST(42.123 AS FLOAT(24))')
)
----
FLOAT

query I
SELECT column_type from (
  DESCRIBE FROM odbc_query(getvariable('conn'), 'SELECT CAST(42.123 AS FLOAT(25))')
)
----
DOUBLE

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(42.123 AS FLOAT)')
----
42.123

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(42.123 AS FLOAT)',
  enable_columns_binding=TRUE)
----
42.123

statement error
FROM odbc_query(getvariable('conn'), 'SELECT CAST(''foo'' AS NVARCHAR(max)), CAST(42.123 AS FLOAT)',
  enable_columns_binding=TRUE)
----
Invalid Descriptor Index

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS FLOAT)', params=row(42.123::DOUBLE))
----
42.123

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS FLOAT(24))', params=row(42.123::FLOAT))
----
42.123

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS FLOAT)', params=row(0::DOUBLE))
----
0

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS FLOAT)', params=row(-42.123::DOUBLE))
----
-42.123

statement ok
PREPARE p1 AS FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS FLOAT)', params=row(?))

query I
EXECUTE p1(42.123::DOUBLE)
----
42.123

statement ok
DEALLOCATE p1

statement ok
SELECT odbc_close(getvariable('conn'))
