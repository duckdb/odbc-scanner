# name: test/sql/mssql/23_ntext.test
# description: test for MSSQL NTEXT type
# group: [mssql_23_ntext]

require odbc_scanner

require-env ODBC_CONN_STRING

statement ok
SET VARIABLE conn = odbc_connect('${ODBC_CONN_STRING}')

query I
SELECT * FROM odbc_query(getvariable('conn'), 'SELECT CAST(''foo'' AS NTEXT)')
----
foo

query I
SELECT column_type from (
  DESCRIBE SELECT * FROM odbc_query(getvariable('conn'), 'SELECT CAST(''foo'' AS NTEXT)')
)
----
VARCHAR

query I
SELECT * FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS NTEXT)', params=row('foo'::VARCHAR))
----
foo

query I
SELECT * FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS NTEXT)', params=row('🌌'::VARCHAR))
----
🌌

query I
SELECT * FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS NTEXT)', params=row(NULL::VARCHAR))
----
NULL

statement ok
SET VARIABLE params1 = odbc_create_params()

statement ok
PREPARE p1 AS SELECT * FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS NTEXT)', params_handle=getvariable('params1'))

statement ok
PREPARE p1_bind AS SELECT odbc_bind_params(getvariable('conn'), getvariable('params1'), row(?))

statement ok
EXECUTE p1_bind('foo'::VARCHAR)

query I
EXECUTE p1
----
foo

statement ok
EXECUTE p1_bind('🌌'::VARCHAR)

query I
EXECUTE p1
----
🌌

statement ok
DEALLOCATE p1_bind

statement ok
DEALLOCATE p1

statement ok
SELECT odbc_close(getvariable('conn'))
