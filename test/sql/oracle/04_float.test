# name: test/sql/oracle/04_float.test
# description: test for Oracle FLOAT type
# group: [oracle_10_float]

require odbc_scanner

require-env ODBC_CONN_STRING

statement ok
SET VARIABLE conn = odbc_connect('${ODBC_CONN_STRING}')

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(42.123 AS FLOAT(126)) FROM dual')
----
42.123

query I
SELECT column_type from (
  DESCRIBE FROM odbc_query(getvariable('conn'), 'SELECT CAST(42.123 AS FLOAT) FROM dual')
)
----
DOUBLE

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(42.123 AS FLOAT(24)) FROM dual')
----
42.123

query I
SELECT column_type from (
  DESCRIBE FROM odbc_query(getvariable('conn'), 'SELECT CAST(42.123 AS FLOAT(24)) FROM dual')
)
----
DOUBLE

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(42.123 AS FLOAT) FROM dual')
----
42.123

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS FLOAT) FROM dual', params=row(42.123::DOUBLE))
----
42.123

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS FLOAT(24)) FROM dual', params=row(42.123::FLOAT))
----
42.123

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS FLOAT) FROM dual', params=row(0::DOUBLE))
----
0

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS FLOAT) FROM dual', params=row(-42.123::DOUBLE))
----
-42.123

statement ok
PREPARE p1 AS FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS FLOAT) FROM dual', params=row(?))

query I
EXECUTE p1(42.123::DOUBLE)
----
42.123

statement ok
DEALLOCATE p1

statement ok
SELECT odbc_close(getvariable('conn'))
