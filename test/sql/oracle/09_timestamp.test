# name: test/sql/oracle/09_timestamp.test
# description: test for TIMESTAMP type with Oracle
# group: [oracle_09_timestamp]

require odbc_scanner

require-env ODBC_CONN_STRING

statement ok
SET VARIABLE conn = odbc_connect('${ODBC_CONN_STRING}')

query I
FROM odbc_query(getvariable('conn'),
  'SELECT to_timestamp(''2020-12-31 12:34:56.123456789'', ''YYYY-MM-DD HH24:MI:SS.FF9'') FROM dual')
----
2020-12-31 12:34:56.123456

query I
SELECT column_type from (
  DESCRIBE FROM odbc_query(getvariable('conn'),
    'SELECT to_timestamp(''2020-12-31 12:34:56.123456789'', ''YYYY-MM-DD HH24:MI:SS.FF9'') FROM dual')
)
----
TIMESTAMP

query I
FROM odbc_query(getvariable('conn'),
  'SELECT to_timestamp(''2020-12-31 12:34:56.123456789'', ''YYYY-MM-DD HH24:MI:SS.FF9'') FROM dual',
  timestamp_columns_as_timestamp_ns=TRUE)
----
2020-12-31 12:34:56.123456789

query I
SELECT column_type from (
  DESCRIBE FROM odbc_query(getvariable('conn'),
    'SELECT to_timestamp(''2020-12-31 12:34:56.123456789'', ''YYYY-MM-DD HH24:MI:SS.FF9'') FROM dual',
    timestamp_columns_as_timestamp_ns=TRUE)
)
----
TIMESTAMP_NS

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS TIMESTAMP(6)) FROM dual',
  params=row('2020-12-31 23:58:59.123456'::TIMESTAMP))
----
2020-12-31 23:58:59.123456

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS TIMESTAMP(9)) FROM dual',
  params=row('2020-12-31 23:58:59.123456'::TIMESTAMP))
----
2020-12-31 23:58:59.123456

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS TIMESTAMP(3)) FROM dual',
  params=row('2020-12-31 23:58:59.123456'::TIMESTAMP))
----
2020-12-31 23:58:59.123

statement ok
PREPARE p1 AS FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS TIMESTAMP(9)) FROM dual',
  params=row(?))

query I
EXECUTE p1('2020-12-31 23:58:59.123456'::TIMESTAMP)
----
2020-12-31 23:58:59.123456

query I
EXECUTE p1('1970-01-01 00:00:00'::TIMESTAMP)
----
1970-01-01 00:00:00

query I
EXECUTE p1('1969-12-31 00:00:00'::TIMESTAMP)
----
1969-12-31 00:00:00

query I
EXECUTE p1('0001-01-01 00:00:00.000000'::TIMESTAMP)
----
0001-01-01 00:00:00

query I
EXECUTE p1('9999-12-31 23:59:59.999999'::TIMESTAMP)
----
9999-12-31 23:59:59.999999

statement ok
DEALLOCATE p1

statement ok
PREPARE p2 AS FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS TIMESTAMP(9)) FROM dual',
  params=row(?),
  timestamp_columns_as_timestamp_ns=TRUE)

query I
EXECUTE p2('2020-12-31 23:58:59.123456'::TIMESTAMP)
----
2020-12-31 23:58:59.123456

query I
EXECUTE p2('2020-12-31 23:58:59.123456789'::TIMESTAMP_NS)
----
2020-12-31 23:58:59.123456789

query I
EXECUTE p2('0001-01-01 00:00:00.000000'::TIMESTAMP)
----
-infinity

query I
EXECUTE p2('9999-12-31 23:59:59.999999'::TIMESTAMP)
----
infinity

statement ok
DEALLOCATE p2

statement ok
SELECT odbc_close(getvariable('conn'))
