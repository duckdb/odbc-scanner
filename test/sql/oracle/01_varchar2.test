# name: test/sql/oracle/01_varchar2.test
# description: test for Oracle VARCHAR2 type
# group: [oracle_01_varchar2]

require odbc_scanner

require-env ODBC_CONN_STRING

statement ok
SET VARIABLE conn = odbc_connect('${ODBC_CONN_STRING}')

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(''foo'' AS VARCHAR2(3)) FROM dual')
----
foo

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(''foo'' AS VARCHAR2(6)) FROM dual')
----
foo

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(''foo'' AS VARCHAR2(4000)) FROM dual')
----
foo

query I
SELECT column_type from (
  DESCRIBE FROM odbc_query(getvariable('conn'), 'SELECT CAST(''foo'' AS VARCHAR2(4000)) FROM dual')
)
----
VARCHAR

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS VARCHAR2(4000)) FROM dual', params=row('foo'::VARCHAR))
----
foo

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS VARCHAR2(4000)) FROM dual', params=row('🌌'::VARCHAR))
----
?

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS VARCHAR2(4000)) FROM dual', params=row(NULL::VARCHAR))
----
NULL

statement ok
PREPARE p1 AS FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS VARCHAR2(4000)) FROM dual',
  params=row(?))

query I
EXECUTE p1('foo'::VARCHAR)
----
foo

query I
EXECUTE p1('bar'::VARCHAR)
----
bar

statement ok
DEALLOCATE p1

statement ok
SELECT odbc_close(getvariable('conn'))
