# name: test/sql/oracle/22_blob.test
# description: test for Oracle BLOB type
# group: [oracle_22_blob]

require odbc_scanner

require-env ODBC_CONN_STRING

statement ok
SET VARIABLE conn = odbc_connect('${ODBC_CONN_STRING}')

query I
FROM odbc_query(getvariable('conn'), 'SELECT to_blob(hextoraw(''666f6f00626172'')) FROM dual')
----
foo\x00bar

query I
FROM odbc_query(getvariable('conn'), 'SELECT to_blob(CAST(? AS RAW(3))) FROM dual',
  params=row('foo'::BLOB))
----
foo

query I
FROM odbc_query(getvariable('conn'), 'SELECT to_blob(CAST(? AS RAW(6))) FROM dual',
  params=row('foo'::BLOB))
----
foo

query I
FROM odbc_query(getvariable('conn'), 'SELECT to_blob(CAST(? AS RAW(7))) FROM dual',
  params=row('foo\x00bar'::BLOB))
----
foo\x00bar

query I
FROM odbc_query(getvariable('conn'), 'SELECT to_blob(CAST(? AS RAW(2000))) FROM dual',
  params=row(NULL::BLOB))
----
NULL

statement ok
PREPARE p1 AS FROM odbc_query(getvariable('conn'), 'SELECT to_blob(CAST(? AS RAW(7))) FROM dual',
  params=row(?))

query I
EXECUTE p1('foo\x00bar'::BLOB)
----
foo\x00bar

statement ok
DEALLOCATE p1

statement ok
SELECT odbc_close(getvariable('conn'))
