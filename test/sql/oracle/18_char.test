# name: test/sql/oracle/18_char.test
# description: test for Oracle CHAR type
# group: [oracle_18_char]

require odbc_scanner

require-env ODBC_CONN_STRING

statement ok
SET VARIABLE conn = odbc_connect('${ODBC_CONN_STRING}')

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(''foo'' AS CHAR(3)) FROM dual')
----
foo

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(''foo'' AS CHAR(6)) FROM dual')
----
foo   

query I
SELECT column_type from (
  DESCRIBE FROM odbc_query(getvariable('conn'), 'SELECT CAST(''foo'' AS CHAR(3)) FROM dual')
)
----
VARCHAR

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS CHAR(3)) FROM dual', params=row('foo'::VARCHAR))
----
foo

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS CHAR(4)) FROM dual', params=row('🌌'::VARCHAR))
----
?

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS CHAR(2)) FROM dual', params=row(NULL::VARCHAR))
----
NULL

statement ok
PREPARE p1 AS FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS CHAR(3)) FROM dual',
  params=row(?))

query I
EXECUTE p1('foo'::VARCHAR)
----
foo

query I
EXECUTE p1('bar'::VARCHAR)
----
bar

statement ok
DEALLOCATE p1

statement ok
SELECT odbc_close(getvariable('conn'))
