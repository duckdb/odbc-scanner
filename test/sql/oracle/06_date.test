# name: test/sql/oracle/06_date.test
# description: test for DATE type with Oracle
# group: [oracle_06_date]

require odbc_scanner

require-env ODBC_CONN_STRING

statement ok
SET VARIABLE conn = odbc_connect('${ODBC_CONN_STRING}')

query I
FROM odbc_query(getvariable('conn'), 'SELECT to_date(''2020-12-31'', ''YYYY-MM-DD'') FROM dual')
----
2020-12-31

query I
FROM odbc_query(getvariable('conn'), 'SELECT to_date(''-4712-01-01'', ''sYYYY-MM-DD'') FROM dual')
----
4713-01-01 (BC)

query I
FROM odbc_query(getvariable('conn'), 'SELECT to_date(''9999-12-31'', ''YYYY-MM-DD'') FROM dual')
----
9999-12-31

query I
SELECT column_type from (
  DESCRIBE FROM odbc_query(getvariable('conn'), 'SELECT to_date(''2020-12-31'', ''YYYY-MM-DD'') FROM dual')
)
----
DATE

query II
FROM odbc_query(getvariable('conn'), 'SELECT CAST(42 AS INT), to_date(''2020-12-31'', ''YYYY-MM-DD'') FROM dual')
----
42	2020-12-31

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS DATE) FROM dual', params=row('2020-12-31'::DATE))
----
2020-12-31

statement ok
PREPARE p1 AS FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS DATE) FROM dual', params=row(?))

query I
EXECUTE p1('2020-12-31'::DATE)
----
2020-12-31

query I
EXECUTE p1('1970-01-01'::DATE)
----
1970-01-01

query I
EXECUTE p1('1969-12-31'::DATE)
----
1969-12-31

query I
EXECUTE p1('4713-01-01 (BC)'::DATE)
----
4713-01-01 (BC)

query I
EXECUTE p1('9999-12-31'::DATE)
----
9999-12-31

statement ok
DEALLOCATE p1

statement ok
SELECT odbc_close(getvariable('conn'))
