# name: test/sql/oracle/19_nchar.test
# description: test for Oracle NCHAR type
# group: [oracle_19_nchar]

require odbc_scanner

require-env ODBC_CONN_STRING

statement ok
SET VARIABLE conn = odbc_connect('${ODBC_CONN_STRING}')

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(''foo'' AS NCHAR(3)) FROM dual')
----
foo

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(''foo'' AS NCHAR(6)) FROM dual')
----
foo   

query I
SELECT column_type from (
  DESCRIBE FROM odbc_query(getvariable('conn'), 'SELECT CAST(''foo'' AS NCHAR(3)) FROM dual')
)
----
VARCHAR

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS NCHAR(3)) FROM dual', params=row('foo'::VARCHAR))
----
foo

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS NCHAR(2)) FROM dual', params=row('🌌'::VARCHAR))
----
🌌

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS NCHAR(2)) FROM dual', params=row(NULL::VARCHAR))
----
NULL

statement ok
PREPARE p1 AS FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS NCHAR(3)) FROM dual',
  params=row(?))

query I
EXECUTE p1('foo'::VARCHAR)
----
foo

query I
EXECUTE p1('🌌'::VARCHAR)
----
🌌 

statement ok
DEALLOCATE p1

statement ok
SELECT odbc_close(getvariable('conn'))
