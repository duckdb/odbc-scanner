# name: test/sql/oracle/12_interval_year_to_month.test
# description: test for Oracle INTERVAL YEAR TO MONTH type
# group: [oracle_12_interval_year_to_month]

require odbc_scanner

require-env ODBC_CONN_STRING

statement ok
SET VARIABLE conn = odbc_connect('${ODBC_CONN_STRING}')

query I
FROM odbc_query(getvariable('conn'),
  'SELECT CAST(to_yminterval(''01-02'') AS VARCHAR2(64)) FROM dual')
----
+000000001-02

statement error
FROM odbc_query(getvariable('conn'),
  'SELECT to_yminterval(''01-02'') FROM dual')
----
Binder Error: 'SQLNumResultCols' failed

query I
FROM odbc_query(getvariable('conn'),
  'SELECT CAST(to_yminterval(?) AS VARCHAR2(64)) FROM dual',
  params=row('01-02'::VARCHAR))
----
INTERVAL'+000000001-02'YEAR(9)TO MONTH

statement error
FROM odbc_query(getvariable('conn'),
  'SELECT to_yminterval(?) FROM dual',
  params=row('01-02'::VARCHAR))
----
Binder Error: 'SQLNumResultCols' failed

statement ok
PREPARE p1 AS FROM odbc_query(getvariable('conn'),
  'SELECT CAST(to_yminterval(?) AS VARCHAR2(64)) FROM dual',
  params=row(?))

query I
EXECUTE p1('01-02'::VARCHAR)
----
INTERVAL'+000000001-02'YEAR(9)TO MONTH

query I
EXECUTE p1('03-04'::VARCHAR)
----
INTERVAL'+000000003-04'YEAR(9)TO MONTH

statement ok
DEALLOCATE p1

statement ok
SELECT odbc_close(getvariable('conn'))
