# name: test/sql/oracle/07_binary_float.test
# description: test for Oracle BINARY_FLOAT type
# group: [oracle_07_binary_float]

require odbc_scanner

require-env ODBC_CONN_STRING

statement ok
SET VARIABLE conn = odbc_connect('${ODBC_CONN_STRING}')

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(42.123 AS BINARY_FLOAT) FROM dual')
----
42.123

query I
SELECT column_type from (
  DESCRIBE FROM odbc_query(getvariable('conn'), 'SELECT CAST(42.123 AS BINARY_FLOAT) FROM dual')
)
----
FLOAT

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(42.123 AS BINARY_FLOAT) FROM dual')
----
42.123

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS BINARY_FLOAT) FROM dual', params=row(42.123::FLOAT))
----
42.123

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS BINARY_FLOAT) FROM dual', params=row(0::FLOAT))
----
0

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS BINARY_FLOAT) FROM dual', params=row(-42.123::FLOAT))
----
-42.123

statement ok
PREPARE p1 AS FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS BINARY_FLOAT) FROM dual', params=row(?))

query I
EXECUTE p1(42.123::FLOAT)
----
42.123

statement ok
DEALLOCATE p1

statement ok
SELECT odbc_close(getvariable('conn'))
