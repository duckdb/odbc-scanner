# name: test/sql/mysql/date.test
# description: test for MySQL DATE type
# group: [sql_mysql_date]

require odbc_scanner

require-env ODBC_CONN_STRING

require-env MYSQL_AVAILABLE

statement ok
SET VARIABLE conn = odbc_connect('${ODBC_CONN_STRING}')

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(''2020-12-31'' AS DATE)')
----
2020-12-31

query I
SELECT column_type from (
  DESCRIBE FROM odbc_query(getvariable('conn'), 'SELECT CAST(''2020-12-31'' AS DATE)')
)
----
DATE

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS DATE)', params=row('2020-12-31'::DATE))
----
2020-12-31

statement ok
PREPARE p1 AS FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS DATE)', params=row(?))

query I
EXECUTE p1('2020-12-31'::DATE)
----
2020-12-31

query I
EXECUTE p1('1970-01-01'::DATE)
----
1970-01-01

query I
EXECUTE p1('1969-12-31'::DATE)
----
1969-12-31

statement ok
DEALLOCATE p1

statement ok
SELECT odbc_close(getvariable('conn'))
