# name: test/sql/mysql/integer.test
# description: test for MySQL INTEGER type
# group: [sql_mysql_integer]

require odbc_scanner

require-env ODBC_CONN_STRING

require-env MYSQL_AVAILABLE

statement ok
SET VARIABLE conn = odbc_connect('${ODBC_CONN_STRING}')

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(42 AS SIGNED)')
----
42

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS SIGNED)', params=row(42::INTEGER))
----
42

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS SIGNED)', params=row(0::INTEGER))
----
0

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS SIGNED)', params=row(2147483647::INTEGER))
----
2147483647

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS SIGNED)', params=row(-2147483647::INTEGER))
----
-2147483647

statement ok
PREPARE p1 AS FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS SIGNED)', params=row(?))

query I
EXECUTE p1(2147483647::INTEGER)
----
2147483647

statement ok
DEALLOCATE p1

statement ok
SELECT odbc_close(getvariable('conn'))
