# name: test/sql/snowflake/01_number.test
# description: test for Snowflake NUMBER type
# group: [snowflake_01_number]

require odbc_scanner

require-env ODBC_CONN_STRING

statement ok
SET VARIABLE conn = odbc_connect('${ODBC_CONN_STRING}')

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(''1.234'' AS NUMBER(4,3))')
----
1.234

query I
SELECT column_type from (
  DESCRIBE FROM odbc_query(getvariable('conn'), 'SELECT CAST(''1.234'' AS NUMBER(4,3))')
)
----
DECIMAL(4,3)

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(''123456.789'' AS NUMBER(9,3))')
----
123456.789

query I
SELECT column_type from (
  DESCRIBE FROM odbc_query(getvariable('conn'), 'SELECT CAST(''123456.789'' AS NUMBER(9,3))')
)
----
DECIMAL(9,3)

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(''123456789012345.123'' AS NUMBER(18,3))')
----
123456789012345.123

query I
SELECT column_type from (
  DESCRIBE FROM odbc_query(getvariable('conn'), 'SELECT CAST(''123456789012345.123'' AS NUMBER(18,3))')
)
----
DECIMAL(18,3)

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(''12345678901234567890123456789012345.123'' AS NUMBER(38,3))')
----
12345678901234567890123456789012345.123

query I
SELECT column_type from (
  DESCRIBE FROM odbc_query(getvariable('conn'), 'SELECT CAST(''12345678901234567890123456789012345.123'' AS NUMBER(38,3))')
)
----
DECIMAL(38,3)

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS NUMBER(38,3))', params=row('12345678901234567890123456789012345.123'::DECIMAL(38,3)))
----
12345678901234567890123456789012345.123

statement ok
PREPARE p16 AS FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS NUMBER(4,3))', params=row(?))

query I
EXECUTE p16('1.234'::DECIMAL(4,3))
----
1.234

query I
EXECUTE p16('9.999'::DECIMAL(4,3))
----
9.999

query I
EXECUTE p16('-1.234'::DECIMAL(4,3))
----
-1.234

query I
EXECUTE p16('-9.999'::DECIMAL(4,3))
----
-9.999

query I
EXECUTE p16('0.000'::DECIMAL(4,3))
----
0.000

query I
EXECUTE p16('-0.000'::DECIMAL(4,3))
----
-0.000

statement ok
DEALLOCATE p16

statement ok
PREPARE p32 AS FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS NUMBER(9,3))', params=row(?))

query I
EXECUTE p32('123456.789'::DECIMAL(9,3))
----
123456.789

query I
EXECUTE p32('999999.999'::DECIMAL(9,3))
----
999999.999

query I
EXECUTE p32('-123456.789'::DECIMAL(9,3))
----
-123456.789

query I
EXECUTE p32('-999999.999'::DECIMAL(9,3))
----
-999999.999

query I
EXECUTE p32('000000.000'::DECIMAL(9,3))
----
000000.000

query I
EXECUTE p32('-000000.000'::DECIMAL(9,3))
----
-000000.000

statement ok
DEALLOCATE p32

statement ok
PREPARE p64 AS FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS NUMBER(18,3))', params=row(?))

query I
EXECUTE p64('123456789012345.123'::DECIMAL(18,3))
----
123456789012345.123

query I
EXECUTE p64('999999999999999.999'::DECIMAL(18,3))
----
999999999999999.999

query I
EXECUTE p64('-123456789012345.123'::DECIMAL(18,3))
----
-123456789012345.123

query I
EXECUTE p64('-999999999999999.999'::DECIMAL(18,3))
----
-999999999999999.999

query I
EXECUTE p64('000000000000000.000'::DECIMAL(18,3))
----
000000000000000.000

query I
EXECUTE p64('-000000000000000.000'::DECIMAL(18,3))
----
-000000000000000.000

statement ok
DEALLOCATE p64

statement ok
PREPARE p128 AS FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS NUMBER(38,3))', params=row(?))

query I
EXECUTE p128('12345678901234567890123456789012345.123'::DECIMAL(38,3))
----
12345678901234567890123456789012345.123

query I
EXECUTE p128('99999999999999999999999999999999999.999'::DECIMAL(38,3))
----
99999999999999999999999999999999999.999

query I
EXECUTE p128('-12345678901234567890123456789012345.123'::DECIMAL(38,3))
----
-12345678901234567890123456789012345.123

query I
EXECUTE p128('-99999999999999999999999999999999999.999'::DECIMAL(38,3))
----
-99999999999999999999999999999999999.999

query I
EXECUTE p128('00000000000000000000000000000000000.000'::DECIMAL(38,3))
----
00000000000000000000000000000000000.000

query I
EXECUTE p128('-00000000000000000000000000000000000.000'::DECIMAL(38,3))
----
-00000000000000000000000000000000000.000

statement ok
DEALLOCATE p128

statement ok
SELECT odbc_close(getvariable('conn'))
