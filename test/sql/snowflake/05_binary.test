# name: test/sql/snowflake/05_binary.test
# description: test for Snowflake BINARY type
# group: [snowflake_05_binary]

require odbc_scanner

require-env ODBC_CONN_STRING

statement ok
SET VARIABLE conn = odbc_connect('${ODBC_CONN_STRING}')

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(''666f6f00626172'' AS BINARY)')
----
foo\x00bar

query I
SELECT column_type from (
  DESCRIBE FROM odbc_query(getvariable('conn'), 'SELECT CAST(''666f6f626172'' AS BINARY)')
)
----
BLOB

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS BINARY)', params=row('foo'::BLOB))
----
foo

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS BINARY)', params=row('foo'::BLOB))
----
foo

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS BINARY)', params=row('foo\x00bar'::BLOB))
----
foo\x00bar

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS BINARY)', params=row(NULL::BLOB))
----
NULL

statement ok
PREPARE p1 AS FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS BINARY)', params=row(?))

query I
EXECUTE p1('foo\x00bar'::BLOB)
----
foo\x00bar

statement ok
DEALLOCATE p1

statement ok
SELECT odbc_close(getvariable('conn'))
