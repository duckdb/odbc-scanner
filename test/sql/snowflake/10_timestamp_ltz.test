# name: test/sql/snowflake/10_timestamp_ltz.test
# description: test for Snowflake TIMESTAMP_LTZ type
# group: [snowflake_10_timestamp_ltz]

require odbc_scanner

require-env ODBC_CONN_STRING

statement ok
SET VARIABLE conn = odbc_connect('${ODBC_CONN_STRING}')

statement ok
CALL odbc_query(getvariable('conn'), 'ALTER SESSION SET TIMEZONE = ''Australia/Darwin''')

query I
FROM odbc_query(getvariable('conn'),
  'SELECT to_timestamp_ltz(''2020-12-31 12:34:56.123456789-05:00'', ''YYYY-MM-DD HH24:MI:SS.FF9TZH:TZM'')')
----
2020-12-31 17:34:56.123456

query I
SELECT column_type from (
  DESCRIBE FROM odbc_query(getvariable('conn'),
    'SELECT to_timestamp_ltz(''2020-12-31 12:34:56.123456789-05:00'', ''YYYY-MM-DD HH24:MI:SS.FF9TZH:TZM'')')
)
----
TIMESTAMP

query I
FROM odbc_query(getvariable('conn'),
  'SELECT to_timestamp_ltz(''2020-12-31 12:34:56.123456789-05:00'', ''YYYY-MM-DD HH24:MI:SS.FF9TZH:TZM'')',
  timestamp_columns_as_timestamp_ns=TRUE)
----
2020-12-31 17:34:56.123456789

query I
SELECT column_type from (
  DESCRIBE FROM odbc_query(getvariable('conn'),
    'SELECT to_timestamp_ltz(''2020-12-31 12:34:56.123456789-05:00'', ''YYYY-MM-DD HH24:MI:SS.FF9TZH:TZM'')',
    timestamp_columns_as_timestamp_ns=TRUE)
)
----
TIMESTAMP_NS

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS TIMESTAMP_LTZ)',
  params=row('2020-12-31 23:58:59.123456'::TIMESTAMP))
----
2020-12-31 14:28:59.123456

statement ok
PREPARE p1 AS FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS TIMESTAMP_LTZ)',
  params=row(?))

query I
EXECUTE p1('2020-12-31 23:58:59.123456'::TIMESTAMP)
----
2020-12-31 14:28:59.123456

# CI shift discrpepancy
# query I
# EXECUTE p1('1970-01-01 00:00:00'::TIMESTAMP)
# ----
# 1969-12-31 15:30:00

# todo: check me
# CI shift discrepancy
# query I
# EXECUTE p1('0001-01-01 00:00:00.000000'::TIMESTAMP)
# ----
# 0002-12-31 (BC) 16:16:40

query I
EXECUTE p1('9999-12-31 23:59:59.999999'::TIMESTAMP)
----
9999-12-31 14:29:59.999999

statement ok
DEALLOCATE p1

statement ok
PREPARE p2 AS FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS TIMESTAMP_LTZ)',
  params=row(?),
  timestamp_columns_as_timestamp_ns=TRUE)

query I
EXECUTE p2('2020-12-31 23:58:59.123456'::TIMESTAMP)
----
2020-12-31 14:28:59.123456

query I
EXECUTE p2('2020-12-31 23:58:59.123456789'::TIMESTAMP_NS)
----
2020-12-31 14:28:59.123456789

query I
EXECUTE p2('0001-01-01 00:00:00.000000'::TIMESTAMP)
----
-infinity

query I
EXECUTE p2('9999-12-31 23:59:59.999999'::TIMESTAMP)
----
infinity

statement ok
DEALLOCATE p2

statement ok
SELECT odbc_close(getvariable('conn'))
