# name: test/sql/snowflake/08_time.test
# description: test for Snowflake TIME type
# group: [snowflake_08_time]

require odbc_scanner

require-env ODBC_CONN_STRING

statement ok
SET VARIABLE conn = odbc_connect('${ODBC_CONN_STRING}')

query I
FROM odbc_query(getvariable('conn'), 'SELECT ''23:58:59''::TIME')
----
23:58:59

query I
SELECT column_type from (
  DESCRIBE FROM odbc_query(getvariable('conn'), 'SELECT ''23:58:59''::TIME')
)
----
TIME

query I
FROM odbc_query(getvariable('conn'), 'SELECT ?::TIME', params=row('23:58:59'::TIME))
----
23:58:59

statement ok
PREPARE p1 AS FROM odbc_query(getvariable('conn'), 'SELECT ?::TIME', params=row(?))

query I
EXECUTE p1('23:58:59'::TIME)
----
23:58:59

query I
EXECUTE p1('00:00:00'::TIME)
----
00:00:00

query I
EXECUTE p1('23:58:59.123'::TIME)
----
23:58:59

statement ok
DEALLOCATE p1

statement ok
SELECT odbc_close(getvariable('conn'))
