# name: test/sql/snowflake/03_double.test
# description: test for Snowflake DOUBLE type
# group: [snowflake_03_double]

require odbc_scanner

require-env ODBC_CONN_STRING

statement ok
SET VARIABLE conn = odbc_connect('${ODBC_CONN_STRING}')

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(42.123 AS DOUBLE)')
----
42.123

query I
SELECT column_type from (
  DESCRIBE FROM odbc_query(getvariable('conn'), 'SELECT CAST(42.123 AS DOUBLE)')
)
----
DOUBLE

query I
SELECT column_type from (
  DESCRIBE FROM odbc_query(getvariable('conn'), 'SELECT CAST(42.123 AS FLOAT4)')
)
----
DOUBLE

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(42.123 AS DOUBLE)')
----
42.123

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS DOUBLE)', params=row(42.123::DECIMAL))
----
42.123

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS DOUBLE)', params=row(0::DECIMAL))
----
0

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS DOUBLE)', params=row(-42.123::DECIMAL))
----
-42.123

statement ok
PREPARE p1 AS FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS DOUBLE)', params=row(?))

query I
EXECUTE p1(42.123::DECIMAL)
----
42.123

statement ok
DEALLOCATE p1

statement ok
SELECT odbc_close(getvariable('conn'))
