# name: test/sql/snowflake/07_date.test
# description: test for DATE type with Snowflake
# group: [snowflake_07_date]

require odbc_scanner

require-env ODBC_CONN_STRING

statement ok
SET VARIABLE conn = odbc_connect('${ODBC_CONN_STRING}')

query I
FROM odbc_query(getvariable('conn'), 'SELECT to_date(''2020-12-31'', ''YYYY-MM-DD'')')
----
2020-12-31

query I
FROM odbc_query(getvariable('conn'), 'SELECT to_date(''9999-12-31'', ''YYYY-MM-DD'')')
----
9999-12-31

query I
SELECT column_type from (
  DESCRIBE FROM odbc_query(getvariable('conn'), 'SELECT to_date(''2020-12-31'', ''YYYY-MM-DD'')')
)
----
DATE

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS DATE)', params=row('2020-12-31'::DATE))
----
2020-12-31

statement ok
PREPARE p1 AS FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS DATE)', params=row(?))

query I
EXECUTE p1('2020-12-31'::DATE)
----
2020-12-31

query I
EXECUTE p1('1970-01-01'::DATE)
----
1970-01-01

query I
EXECUTE p1('1969-12-31'::DATE)
----
1969-12-31

# TODO
query I
EXECUTE p1('4713-01-01 (BC)'::DATE)
----
4714-01-02 (BC)

query I
EXECUTE p1('9999-12-31'::DATE)
----
9999-12-31

statement ok
DEALLOCATE p1

statement ok
SELECT odbc_close(getvariable('conn'))
