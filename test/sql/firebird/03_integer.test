# name: test/sql/firebird/03_integer.test
# description: test for Firebird INTEGER types (SMALLINT, INTEGER, BIGINT)
# group: [firebird_integer]

require odbc_scanner

require-env ODBC_CONN_STRING

statement ok
SET VARIABLE conn = odbc_connect('${ODBC_CONN_STRING}')

# SMALLINT test
query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(100 AS SMALLINT) FROM rdb$database')
----
100

query I
SELECT column_type from (
  DESCRIBE FROM odbc_query(getvariable('conn'), 'SELECT CAST(42 AS SMALLINT) FROM rdb$database')
)
----
SMALLINT

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(42 AS SMALLINT) FROM rdb$database',
  enable_columns_binding=TRUE)
----
42

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(-32768 AS SMALLINT) FROM rdb$database')
----
-32768

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(32767 AS SMALLINT) FROM rdb$database')
----
32767

# SMALLINT with parameters
query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS SMALLINT) FROM rdb$database', params=row(42::SMALLINT))
----
42

# INTEGER test
query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(123456 AS INTEGER) FROM rdb$database')
----
123456

query I
SELECT column_type from (
  DESCRIBE FROM odbc_query(getvariable('conn'), 'SELECT CAST(42 AS INTEGER) FROM rdb$database')
)
----
INTEGER

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(42 AS INTEGER) FROM rdb$database',
  enable_columns_binding=TRUE)
----
42

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(-2147483648 AS INTEGER) FROM rdb$database')
----
-2147483648

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(2147483647 AS INTEGER) FROM rdb$database')
----
2147483647

# BIGINT test
query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(9223372036854775807 AS BIGINT) FROM rdb$database')
----
9223372036854775807

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(-9223372036854775808 AS BIGINT) FROM rdb$database')
----
-9223372036854775808

# Hexadecimal format test for INTEGER
query I
FROM odbc_query(getvariable('conn'), 'SELECT 0x7FFFFFFF FROM rdb$database')
----
2147483647

# Hexadecimal format test for BIGINT  
query I
FROM odbc_query(getvariable('conn'), 'SELECT 0x7FFFFFFFFFFFFFFF FROM rdb$database')
----
9223372036854775807

# NULL values
query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(NULL AS INTEGER) FROM rdb$database')
----
NULL

# With parameters
query I
FROM odbc_query(getvariable('conn'), 
  'SELECT CAST(? AS INTEGER) FROM rdb$database',
  params=row(42::INTEGER))
----
42

# Prepared parameter binding (SMALLINT)
statement ok
PREPARE p_smallint AS FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS SMALLINT) FROM rdb$database', params=row(?))

query I
EXECUTE p_smallint(32767::SMALLINT)
----
32767

statement ok
DEALLOCATE p_smallint

# Prepared parameter binding (INTEGER)
statement ok
PREPARE p_integer AS FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS INTEGER) FROM rdb$database', params=row(?))

query I
EXECUTE p_integer(2147483647::INTEGER)
----
2147483647

statement ok
DEALLOCATE p_integer

# Note: INT128 type requires Firebird 4.0+ and is not tested here
# INT128 range: -2^127 to 2^127-1

statement ok
SELECT odbc_close(getvariable('conn'))
