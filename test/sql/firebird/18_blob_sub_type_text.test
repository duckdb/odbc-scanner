# name: test/sql/firebird/18_blob_sub_type_text.test
# description: test for Firebird BLOB SUB_TYPE TEXT type
# group: [firebird_blob_sub_type_text]

require odbc_scanner

require-env ODBC_CONN_STRING

statement ok
SET VARIABLE conn = odbc_connect('${ODBC_CONN_STRING}')

query I
FROM odbc_query(getvariable('conn'), "SELECT CAST(CAST(x'666f6f00626172' AS BLOB SUB_TYPE TEXT) AS VARCHAR(30)) FROM rdb$database")
----
foo

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS BLOB SUB_TYPE TEXT) FROM rdb$database',
  params=row('foo'::BLOB))
----
foo

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(CAST(? AS BLOB SUB_TYPE TEXT) AS VARCHAR(30)) FROM rdb$database',
  params=row('foo\x00bar'::BLOB))
----
foo

query I
FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS BLOB SUB_TYPE TEXT) FROM rdb$database',
  params=row(NULL::BLOB))
----
NULL

statement ok
PREPARE p1 AS FROM odbc_query(getvariable('conn'), 'SELECT CAST(? AS BLOB SUB_TYPE TEXT) FROM rdb$database',
  params=row(?))

query I
EXECUTE p1('foo\x00bar'::BLOB)
----
foo

statement ok
DEALLOCATE p1

statement ok
SELECT odbc_close(getvariable('conn'))
