# name: test/sql/zfailure.test
# description: test that invalid queries don't lead to crashes
# group: [sql_zfailure]

require odbc_scanner

require-env ODBC_CONN_STRING

statement ok
SET VARIABLE conn = odbc_connect('${ODBC_CONN_STRING}')

statement error
FROM odbc_query(getvariable('conn'), 'SELECT FAILURE')
----
Error:

statement ok
SELECT odbc_close(getvariable('conn'))

# keep connection open to check driver's process exit behaviour
statement ok
SET VARIABLE conn_linger = odbc_connect('${ODBC_CONN_STRING}')
