# name: test/sql/duckdb/type_blob.test
# description: test for DuckDB BLOB type
# group: [duckdb_type_utinyint]

require odbc_scanner

require-env ODBC_CONN_STRING

statement ok
SET VARIABLE conn = odbc_connect('${ODBC_CONN_STRING}')

query I
FROM odbc_query(getvariable('conn'), 'SELECT ''foo''::BLOB')
----
foo

query I
SELECT column_type from (
  DESCRIBE FROM odbc_query(getvariable('conn'), 'SELECT ''foo''::BLOB')
)
----
BLOB

query I
FROM odbc_query(getvariable('conn'), 'SELECT ''foo\x00bar''::BLOB')
----
foo\x00bar

query I
FROM odbc_query(getvariable('conn'), 'SELECT ?::BLOB', params=row('foo'::BLOB))
----
foo

query I
FROM odbc_query(getvariable('conn'), 'SELECT ?::BLOB', params=row('foo\x00bar'::BLOB))
----
foo\x00bar

query I
FROM odbc_query(getvariable('conn'), 'SELECT ?::BLOB', params=row(NULL::BLOB))
----
NULL

statement ok
PREPARE p1 AS FROM odbc_query(getvariable('conn'), 'SELECT ?::BLOB', params=row(?))

query I
EXECUTE p1('foo'::BLOB)
----
foo

query I
EXECUTE p1('foo\x00bar'::BLOB)
----
foo\x00bar

statement ok
DEALLOCATE p1

statement ok
SELECT odbc_close(getvariable('conn'))
