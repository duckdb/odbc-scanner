# name: test/sql/duckdb/type_decimal.test
# description: test for DECIMAL type with DuckDB
# group: [duckdb_type_decimal]

require odbc_scanner

require-env ODBC_CONN_STRING

statement ok
SET VARIABLE conn = odbc_connect('${ODBC_CONN_STRING}')

query I
FROM odbc_query(getvariable('conn'), 'SELECT ''1.234''::DECIMAL(4,3)')
----
1.234

query I
SELECT column_type from (
  DESCRIBE FROM odbc_query(getvariable('conn'), 'SELECT ''1.234''::DECIMAL(4,3)')
)
----
DECIMAL(4,3)

query I
FROM odbc_query(getvariable('conn'), 'SELECT ''123456.789''::DECIMAL(9,3)')
----
123456.789

query I
SELECT column_type from (
  DESCRIBE FROM odbc_query(getvariable('conn'), 'SELECT ''123456.789''::DECIMAL(9,3)')
)
----
DECIMAL(9,3)

query I
FROM odbc_query(getvariable('conn'), 'SELECT ''123456789012345.123''::DECIMAL(18,3)')
----
123456789012345.123

query I
SELECT column_type from (
  DESCRIBE FROM odbc_query(getvariable('conn'), 'SELECT ''123456789012345.123''::DECIMAL(18,3)')
)
----
DECIMAL(18,3)

query I
FROM odbc_query(getvariable('conn'), 'SELECT ''12345678901234567890123456789012345.123''::DECIMAL(38,3)')
----
12345678901234567890123456789012345.123

query I
SELECT column_type from (
  DESCRIBE FROM odbc_query(getvariable('conn'), 'SELECT ''12345678901234567890123456789012345.123''::DECIMAL(38,3)')
)
----
DECIMAL(38,3)

query I
FROM odbc_query(getvariable('conn'), 'SELECT ?::DECIMAL(38,3)', params=row('12345678901234567890123456789012345.123'::DECIMAL(38,3)))
----
12345678901234567890123456789012345.123

statement ok
PREPARE p16 AS FROM odbc_query(getvariable('conn'), 'SELECT ?::DECIMAL(4,3)', params=row(?))

query I
EXECUTE p16('1.234'::DECIMAL(4,3))
----
1.234

query I
EXECUTE p16('-1.234'::DECIMAL(4,3))
----
-1.234

statement ok
DEALLOCATE p16

statement ok
PREPARE p32 AS FROM odbc_query(getvariable('conn'), 'SELECT ?::DECIMAL(9,3)', params=row(?))

query I
EXECUTE p32('123456.789'::DECIMAL(9,3))
----
123456.789

query I
EXECUTE p32('-123456.789'::DECIMAL(9,3))
----
-123456.789

statement ok
DEALLOCATE p32

statement ok
PREPARE p64 AS FROM odbc_query(getvariable('conn'), 'SELECT ?::DECIMAL(18,3)', params=row(?))

query I
EXECUTE p64('123456789012345.123'::DECIMAL(18,3))
----
123456789012345.123

query I
EXECUTE p64('-123456789012345.123'::DECIMAL(18,3))
----
-123456789012345.123

statement ok
DEALLOCATE p64

statement ok
PREPARE p128 AS FROM odbc_query(getvariable('conn'), 'SELECT ?::DECIMAL(38,3)', params=row(?))

query I
EXECUTE p128('12345678901234567890123456789012345.123'::DECIMAL(38,3))
----
12345678901234567890123456789012345.123

query I
EXECUTE p128('-12345678901234567890123456789012345.123'::DECIMAL(38,3))
----
-12345678901234567890123456789012345.123

statement ok
DEALLOCATE p128

statement ok
SELECT odbc_close(getvariable('conn'))
