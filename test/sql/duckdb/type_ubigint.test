# name: test/sql/duckdb/type_ubigint.test
# description: test for DuckDB UBIGINT type
# group: [duckdb_type_ubigint]

require odbc_scanner

require-env ODBC_CONN_STRING

statement ok
SET VARIABLE conn = odbc_connect('${ODBC_CONN_STRING}')

query I
FROM odbc_query(getvariable('conn'), 'SELECT 42::UBIGINT')
----
42

query I
SELECT column_type from (
  DESCRIBE FROM odbc_query(getvariable('conn'), 'SELECT 42::UBIGINT')
)
----
UBIGINT

query I
FROM odbc_query(getvariable('conn'), 'SELECT ?::UBIGINT', params=row(42::UBIGINT))
----
42

query I
FROM odbc_query(getvariable('conn'), 'SELECT ?::UBIGINT', params=row(0::UBIGINT))
----
0

query I
FROM odbc_query(getvariable('conn'), 'SELECT ?::UBIGINT', params=row(18446744073709551615::UBIGINT))
----
18446744073709551615

statement ok
PREPARE p1 AS FROM odbc_query(getvariable('conn'), 'SELECT ?::UBIGINT', params=row(?))

query I
EXECUTE p1(18446744073709551615::UBIGINT)
----
18446744073709551615

statement ok
DEALLOCATE p1

statement ok
SELECT odbc_close(getvariable('conn'))
