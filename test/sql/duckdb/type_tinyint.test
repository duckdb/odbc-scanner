# name: test/sql/duckdb/type_tinyint.test
# description: test for DuckDB TINYINT type
# group: [duckdb_type_tinyint]

require odbc_scanner

require-env ODBC_CONN_STRING

statement ok
SET VARIABLE conn = odbc_connect('${ODBC_CONN_STRING}')

query I
FROM odbc_query(getvariable('conn'), 'SELECT 42::TINYINT')
----
42

query I
SELECT column_type from (
  DESCRIBE FROM odbc_query(getvariable('conn'), 'SELECT 42::TINYINT')
)
----
TINYINT

query I
FROM odbc_query(getvariable('conn'), 'SELECT ?::TINYINT', params=row(42::TINYINT))
----
42

query I
FROM odbc_query(getvariable('conn'), 'SELECT ?::TINYINT', params=row(0::TINYINT))
----
0

query I
FROM odbc_query(getvariable('conn'), 'SELECT ?::TINYINT', params=row(127::TINYINT))
----
127

query I
FROM odbc_query(getvariable('conn'), 'SELECT ?::TINYINT', params=row(-127::TINYINT))
----
-127

statement ok
PREPARE p1 AS FROM odbc_query(getvariable('conn'), 'SELECT ?::TINYINT', params=row(?))

query I
EXECUTE p1(127::TINYINT)
----
127

statement ok
DEALLOCATE p1

statement ok
SELECT odbc_close(getvariable('conn'))
