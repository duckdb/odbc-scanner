# name: test/sql/duckdb/type_timestamp.test
# description: test for DuckDB TIMESTAMP type
# group: [duckdb_type_timestamp]

require odbc_scanner

require-env ODBC_CONN_STRING

statement ok
SET VARIABLE conn = odbc_connect('${ODBC_CONN_STRING}')

query I
FROM odbc_query(getvariable('conn'), 'SELECT ''2020-12-31 23:58:59''::TIMESTAMP')
----
2020-12-31 23:58:59

query I
SELECT column_type from (
  DESCRIBE FROM odbc_query(getvariable('conn'), 'SELECT ''2020-12-31 23:58:59''::TIMESTAMP')
)
----
TIMESTAMP

query I
FROM odbc_query(getvariable('conn'), 'SELECT ?::TIMESTAMP', params=row('2020-12-31 23:58:59'::TIMESTAMP))
----
2020-12-31 23:58:59

statement ok
PREPARE p1 AS FROM odbc_query(getvariable('conn'), 'SELECT ?::TIMESTAMP', params=row(?))

query I
EXECUTE p1('2020-12-31 23:58:59.123456789'::TIMESTAMP)
----
2020-12-31 23:58:59.123456

query I
EXECUTE p1('1970-01-01 00:00:00'::TIMESTAMP)
----
1970-01-01 00:00:00

query I
EXECUTE p1('1969-12-31 00:00:00'::TIMESTAMP)
----
1969-12-31 00:00:00

statement ok
DEALLOCATE p1

statement ok
SELECT odbc_close(getvariable('conn'))
