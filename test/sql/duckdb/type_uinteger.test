# name: test/sql/duckdb/type_uinteger.test
# description: test for DuckDB UINTEGER type
# group: [duckdb_type_uinteger]

require odbc_scanner

require-env ODBC_CONN_STRING

statement ok
SET VARIABLE conn = odbc_connect('${ODBC_CONN_STRING}')

query I
FROM odbc_query(getvariable('conn'), 'SELECT 42::UINTEGER')
----
42

query I
SELECT column_type from (
  DESCRIBE FROM odbc_query(getvariable('conn'), 'SELECT 42::UINTEGER')
)
----
UINTEGER

query I
FROM odbc_query(getvariable('conn'), 'SELECT ?::UINTEGER', params=row(42::UINTEGER))
----
42

query I
FROM odbc_query(getvariable('conn'), 'SELECT ?::UINTEGER', params=row(0::UINTEGER))
----
0

query I
FROM odbc_query(getvariable('conn'), 'SELECT ?::UINTEGER', params=row(4294967295::UINTEGER))
----
4294967295

statement ok
PREPARE p1 AS FROM odbc_query(getvariable('conn'), 'SELECT ?::UINTEGER', params=row(?))

query I
EXECUTE p1(4294967295::UINTEGER)
----
4294967295

statement ok
DEALLOCATE p1

statement ok
SELECT odbc_close(getvariable('conn'))
