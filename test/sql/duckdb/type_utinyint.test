# name: test/sql/duckdb/type_utinyint.test
# description: test for DuckDB UTINYINT type
# group: [duckdb_type_utinyint]

require odbc_scanner

require-env ODBC_CONN_STRING

statement ok
SET VARIABLE conn = odbc_connect('${ODBC_CONN_STRING}')

query I
FROM odbc_query(getvariable('conn'), 'SELECT 42::UTINYINT')
----
42

query I
SELECT column_type from (
  DESCRIBE FROM odbc_query(getvariable('conn'), 'SELECT 42::UTINYINT')
)
----
UTINYINT

query I
FROM odbc_query(getvariable('conn'), 'SELECT ?::UTINYINT', params=row(42::UTINYINT))
----
42

query I
FROM odbc_query(getvariable('conn'), 'SELECT ?::UTINYINT', params=row(0::UTINYINT))
----
0

query I
FROM odbc_query(getvariable('conn'), 'SELECT ?::UTINYINT', params=row(255::UTINYINT))
----
255

statement ok
PREPARE p1 AS FROM odbc_query(getvariable('conn'), 'SELECT ?::UTINYINT', params=row(?))

query I
EXECUTE p1(255::UTINYINT)
----
255

statement ok
DEALLOCATE p1

statement ok
SELECT odbc_close(getvariable('conn'))
