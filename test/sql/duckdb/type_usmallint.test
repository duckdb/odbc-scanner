# name: test/sql/duckdb/type_usmallint.test
# description: test for DuckDB USMALLINT type
# group: [duckdb_type_usmallint]

require odbc_scanner

require-env ODBC_CONN_STRING

statement ok
SET VARIABLE conn = odbc_connect('${ODBC_CONN_STRING}')

query I
FROM odbc_query(getvariable('conn'), 'SELECT 42::USMALLINT')
----
42

query I
SELECT column_type from (
  DESCRIBE FROM odbc_query(getvariable('conn'), 'SELECT 42::USMALLINT')
)
----
USMALLINT

query I
FROM odbc_query(getvariable('conn'), 'SELECT ?::USMALLINT', params=row(42::USMALLINT))
----
42

query I
FROM odbc_query(getvariable('conn'), 'SELECT ?::USMALLINT', params=row(0::USMALLINT))
----
0

query I
FROM odbc_query(getvariable('conn'), 'SELECT ?::USMALLINT', params=row(65535::USMALLINT))
----
65535

statement ok
PREPARE p1 AS FROM odbc_query(getvariable('conn'), 'SELECT ?::USMALLINT', params=row(?))

query I
EXECUTE p1(65535::USMALLINT)
----
65535

statement ok
DEALLOCATE p1

statement ok
SELECT odbc_close(getvariable('conn'))
