# name: test/sql/duckdb/type_date.test
# description: test for DATE type with DuckDB
# group: [duckdb_type_date]

require odbc_scanner

require-env ODBC_CONN_STRING

statement ok
SET VARIABLE conn = odbc_connect('${ODBC_CONN_STRING}')

query I
FROM odbc_query(getvariable('conn'), 'SELECT ''2020-12-31''::DATE')
----
2020-12-31

query I
SELECT column_type from (
  DESCRIBE FROM odbc_query(getvariable('conn'), 'SELECT ''2020-12-31''::DATE')
)
----
DATE

query I
FROM odbc_query(getvariable('conn'), 'SELECT ?::DATE', params=row('2020-12-31'::DATE))
----
2020-12-31

statement ok
PREPARE p1 AS FROM odbc_query(getvariable('conn'), 'SELECT ?::DATE', params=row(?))

query I
EXECUTE p1('2020-12-31'::DATE)
----
2020-12-31

query I
EXECUTE p1('1970-01-01'::DATE)
----
1970-01-01

query I
EXECUTE p1('1969-12-31'::DATE)
----
1969-12-31

statement ok
DEALLOCATE p1

statement ok
SELECT odbc_close(getvariable('conn'))
