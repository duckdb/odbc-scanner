# name: test/sql/duckdb/type_integer.test
# description: test for INTEGER type with DuckDB
# group: [duckdb_type_integer]

require odbc_scanner

require-env ODBC_CONN_STRING

statement ok
SET VARIABLE conn = odbc_connect('${ODBC_CONN_STRING}')

query I
FROM odbc_query(getvariable('conn'), 'SELECT 42::INTEGER')
----
42

query I
SELECT column_type from (
  DESCRIBE FROM odbc_query(getvariable('conn'), 'SELECT 42::INTEGER')
)
----
INTEGER

query I
FROM odbc_query(getvariable('conn'), 'SELECT ?::INTEGER', params=row(42::INTEGER))
----
42

query I
FROM odbc_query(getvariable('conn'), 'SELECT ?::INTEGER', params=row(0::INTEGER))
----
0

query I
FROM odbc_query(getvariable('conn'), 'SELECT ?::INTEGER', params=row(2147483647::INTEGER))
----
2147483647

query I
FROM odbc_query(getvariable('conn'), 'SELECT ?::INTEGER', params=row(-2147483647::INTEGER))
----
-2147483647

statement ok
PREPARE p1 AS FROM odbc_query(getvariable('conn'), 'SELECT ?::INTEGER', params=row(?))

query I
EXECUTE p1(2147483647::INTEGER)
----
2147483647

statement ok
DEALLOCATE p1

statement ok
SELECT odbc_close(getvariable('conn'))
