# name: test/sql/duckdb/params.test
# description: test for calls of odbc_query() function with params argument with DuckDB
# group: [duckdb_params]

require odbc_scanner

require-env ODBC_CONN_STRING

statement ok
SET VARIABLE conn = odbc_connect('${ODBC_CONN_STRING}')

statement error
FROM odbc_query(getvariable('conn'), 'SELECT ?::INTEGER', params=NULL)
----
Binder Error: Cannot extract parameters from STRUCT: specified STRUCT is NULL

statement error
FROM odbc_query(getvariable('conn'), 'SELECT ?::INTEGER', params=42)
----
Binder Error: Cannot extract parameters from STRUCT: specified value is not STRUCT

query I
FROM odbc_query(getvariable('conn'), 'SELECT ?::INTEGER', params=row(42))
----
42

statement error
FROM odbc_query(getvariable('conn'), 'SELECT ?::INTEGER', params=row('foo'))
----
Invalid Input Error: 'SQLExecute' failed, query: 'SELECT ?::INTEGER'

statement error
FROM odbc_query(getvariable('conn'), 'SELECT ?::INTEGER', params=row(41, 42))
----
Binder Error: Incorrect number of parameters specified, query: 'SELECT ?::INTEGER', expected: 1, actual: 2

query I
FROM odbc_query(getvariable('conn'), 'SELECT ?::INTEGER', params=row(NULL))
----
NULL

statement ok
PREPARE p1 AS FROM odbc_query(getvariable('conn'), 'SELECT ?::INTEGER', params=row(?))

query I
EXECUTE p1(42)
----
42

query I
EXECUTE p1(43)
----
43

statement ok
DEALLOCATE p1

statement ok
PREPARE p2 AS FROM odbc_query(getvariable('conn'), 'SELECT ?::INTEGER, ?::VARCHAR', params=row(?, ?))

query II
EXECUTE p2(42, 'foo')
----
42	foo

query II
EXECUTE p2(43, 'bar')
----
43	bar

statement ok
DEALLOCATE p2

statement ok
SELECT odbc_close(getvariable('conn'))
