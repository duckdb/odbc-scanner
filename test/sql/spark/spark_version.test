# name: test/sql/spark/spark_version.test
# description: test for Spark version
# group: [sql_spark_version]

require odbc_scanner

require-env ODBC_CONN_STRING

statement ok
SET VARIABLE conn = odbc_connect('${ODBC_CONN_STRING}')

statement ok
CALL odbc_query(getvariable('conn'), 'SELECT version()')

statement ok
SELECT odbc_close(getvariable('conn'))
