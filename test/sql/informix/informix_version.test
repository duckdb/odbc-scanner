# name: test/sql/informix/informix_version.test
# description: test for Informix version
# group: [sql_informix_version]

require odbc_scanner

statement ok
SET VARIABLE conn = odbc_connect('ODBCSCANNER_DEBUG_CONN_STRING_ENV_VAR=ODBC_CONN_STRING')

statement ok
CALL odbc_query(getvariable('conn'), 'SELECT FIRST 1 dbinfo(''version'', ''full'') FROM sysmaster:sysshmvals')

statement ok
SELECT odbc_close(getvariable('conn'))
